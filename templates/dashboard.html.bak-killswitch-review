function mkChart(id,b,cfg){
  killChart(id);
  if(typeof Chart==="undefined"){
    b.innerHTML=empty("Chart library not loaded","Chart.js could not be downloaded. Check the network, ad-blocker or firewall.");
    return;
  }
  b.innerHTML='<div class="cv"><canvas></canvas></div>';
  try{
    cfg.options=cfg.options||{};
    cfg.options.animation=false;
    CH[id]=new Chart(b.querySelector("canvas"),cfg);
    const c=CH[id];
    /* re-measure once layout has settled (fractional display scaling on laptops) */
    requestAnimationFrame(()=>{if(CH[id]===c){c.resize();c.update("none")}});
    setTimeout(()=>{if(CH[id]===c)c.resize()},250);
  }catch(e){
    console.error("Chart "+id+" failed",e,e&&e.stack);
    b.innerHTML=empty("Couldn't draw this chart",esc((e&&e.message)||String(e)));
  }
}

