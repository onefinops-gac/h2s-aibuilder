  return`<svg viewBox="0 0 ${w} ${h}" preserveAspectRatio="none">
    <path d="${d}L${w} ${h}L0 ${h}Z" style="fill:${c};opacity:.12"/>
    <path d="${d}" fill="none" style="stroke:${c};stroke-width:2;stroke-linejoin:round;stroke-linecap:round;vector-effect:non-scaling-stroke"/>
