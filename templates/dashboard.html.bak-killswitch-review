function savedLayout(){
  try{
    const l=JSON.parse(localStorage.getItem(LKEY));
    if(Array.isArray(l)&&l.every(n=>n&&WG[n.type]))return l;
  }catch(e){}
  return null;
}

function shell(id,type){
