const usd=n=>{n=+n||0;return "$"+(n!==0&&Math.abs(n)<.01?n.toFixed(4):n.toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}))};
const N=v=>Math.round(+v||0).toLocaleString();
const P=v=>((+v||0)*100).toFixed(0)+"%";
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const css=v=>getComputedStyle(document.documentElement).getPropertyValue(v).trim()||"#0e7c66";
const PAL=["#0e7c66","#2b5fa8","#c9993f","#7b6bc4","#3aa6c9","#d1675a","#6f8f5a","#5F6368"];
