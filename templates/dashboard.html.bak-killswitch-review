  await advSaveHistory();
}

/* On-demand AI reviews: browser cache and in-flight deduplication. */
const PANEL_AI_CACHE=new Map();
const PANEL_AI_PENDING=new Map();

async function generatePanelAIReview(promptId,button){
  const answerId=promptId==="ks"?"ksAiAnswer":"projectAiAnswer";
  const answer=document.getElementById(answerId);
  if(!answer)return;

  const selection=selQS();
  const cacheKey=promptId+"|"+selection;

  if(PANEL_AI_CACHE.has(cacheKey)){
    answer.textContent=PANEL_AI_CACHE.get(cacheKey);
    return;
  }
  if(PANEL_AI_PENDING.has(cacheKey))return;

  const original=button.textContent;
  button.disabled=true;
  button.textContent="Generating…";
  answer.textContent="Generating an evidence-based AI review…";

  const request=(async()=>{
    // Use trusted predefined prompts; no custom-question guard classification.
    const body={prompt_id:promptId,period:S.p};
    if(S.date)body.date=S.date;
    if(S.month)body.month=S.month;
    if(S.year)body.year=S.year;
    if(S.cu)body[CUKEY[S.p]]=S.cu;

    const response=await fetch("/api/advisor/ask",{
      method:"POST",
      headers:await advAuthHeaders(),
      body:JSON.stringify(body),
      cache:"no-store",
      signal:AbortSignal.timeout(45000)
    });
    const data=await response.json().catch(()=>({}));
    if(!response.ok){
      throw new Error(data.error||data.message||("Advisor request failed (HTTP "+response.status+")"));
    }
    const result=String(data.answer||"No answer returned.");
    PANEL_AI_CACHE.set(cacheKey,result);
    return result;
  })();

  PANEL_AI_PENDING.set(cacheKey,request);
  try{
    answer.textContent=await request;
  }catch(e){
    answer.textContent="AI review unavailable: "+(e.message||"request failed")+". Your rules-based recommendations remain available.";
  }finally{
    PANEL_AI_PENDING.delete(cacheKey);
    button.disabled=false;
    button.textContent=original;
  }
}

