const cap=s=>s[0].toUpperCase()+s.slice(1);
const nm=e=>{const l=String(e).split("@")[0];return l.split(/[._-]/).filter(Boolean).map(w=>w[0].toUpperCase()+w.slice(1)).join(" ")||String(e)};
const ini=e=>nm(e).split(" ").map(w=>w[0]).slice(0,2).join("").toUpperCase();
const hue=s=>{let h=0;for(const c of String(s))h=(h*31+c.charCodeAt(0))%360;return h};
const avatar=e=>`<span class="av" style="--h:${hue(e)}">${esc(ini(e))}</span>`;
const empty=(h,p)=>`<div class="empty"><b>${h}</b>${p||""}</div>`;

const S={p:"monthly",cu:null,v:"overview",demo:null,rows:[],trend:[],act:[],sort:{},q:{},lim:{},sel:null,ud:[],busy:false,ci:0,edit:false,loaded:false};
const CH={};
let W={},grid=null,loading=false;
