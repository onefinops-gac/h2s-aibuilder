function projectRecs(){
  const host=$("#projectRecList");
  if(!host)return;
  if(!S.rows||!S.rows.length){
    host.innerHTML='<div class="muted">No project usage data for this period.</div>';
    return;
  }

  const projects=agg("project").filter(p=>p.name&&!/^unknown/i.test(p.name));
  const all=[];
  for(const p of projects){
    const ev=S.rows.filter(r=>r.project===p.name);
    if(!ev.length||p.cost<=0)continue;
    const models=new Map(),days=new Map();
    ev.forEach(r=>{
      const m=String(r.model||"Unknown");
      const mo=models.get(m)||{cost:0,tokens:0,rows:0};
      mo.cost+=Math.max(0,+r.cost||0);
      mo.tokens+=Math.max(0,+r.tokens||0);
      mo.rows++;models.set(m,mo);
      const d=String(r.time||"").slice(0,10);
      if(d){
        const day=days.get(d)||{cost:0,tokens:0,rows:0};
        day.cost+=Math.max(0,+r.cost||0);
        day.tokens+=Math.max(0,+r.tokens||0);
        day.rows++;days.set(d,day);
      }
    });

    const ms=[...models.entries()].sort((a,b)=>b[1].cost-a[1].cost);
    const ds=[...days.entries()].sort((a,b)=>a[0].localeCompare(b[0]));
    const candidates=[];
    const add=(score,tone,title,text,tag)=>candidates.push({score,tone,title,text,tag});

    if(ms.length&&p.cost>0){
      const [name,m]=ms[0],pct=m.cost/p.cost;
      if(pct>=.65){
        add(80,"warn","One model dominates project spend",
          `${name} accounts for ${(pct*100).toFixed(0)}% of ${p.name}'s recorded cost (${usd(m.cost)}). Review whether routine tasks can use a less expensive model without compromising output quality.`,
          `Evidence: ${N(m.rows)} activity rows`);
      }
      const rates=ms.filter(([,v])=>v.tokens>0&&v.cost>0)
        .map(([name,v])=>({name,rate:v.cost/v.tokens*1000,cost:v.cost}))
        .sort((a,b)=>a.rate-b.rate);
      if(rates.length>=2){
        const low=rates[0],high=rates[rates.length-1];
        if(high.rate>=low.rate*3&&high.cost/p.cost>=.2){
          add(75,"good","Compare the project's high-cost model",
            `${high.name} costs about ${(high.rate/low.rate).toFixed(1)}× as much per 1,000 recorded tokens as ${low.name}. Compare representative tasks and quality before considering a routing change.`,
            `Observed cost per 1K tokens: ${usd(high.rate)} vs ${usd(low.rate)}`);
        }
      }
    }

    if(ds.length>=5){
      const vals=ds.map(([,d])=>d.cost).sort((a,b)=>a-b);
      const mid=vals.length%2?vals[Math.floor(vals.length/2)]:(vals[vals.length/2-1]+vals[vals.length/2])/2;
      const peak=ds.reduce((best,item)=>item[1].cost>best[1].cost?item:best,ds[0]);
      if(mid>0&&peak[1].cost>=mid*2.5){
        add(95,"bad","Investigate a project spending spike",
          `${p.name} spent ${usd(peak[1].cost)} on ${peak[0]}, about ${(peak[1].cost/mid).toFixed(1)}× the median across observed days. Check batch jobs, retries and unusually heavy workloads on that date.`,
          "Evidence: daily cost in selected period");
      }
    }

    const sizes=ev.map(r=>Math.max(0,+r.tokens||0)).filter(n=>n>0).sort((a,b)=>a-b);
    if(sizes.length>=8){
      const median=sizes.length%2?sizes[Math.floor(sizes.length/2)]:(sizes[sizes.length/2-1]+sizes[sizes.length/2])/2;
      const avg=sizes.reduce((a,b)=>a+b,0)/sizes.length;
      const largest=sizes[sizes.length-1];
      if(median>0&&avg>=median*2.5&&largest>=median*4){
        add(88,"warn","Check unusually large project requests",
          `The average recorded request is ${fmt(avg)} tokens versus a median of ${fmt(median)}; the largest is ${fmt(largest)}. Inspect large inputs and long context before changing model or caching settings.`,
          `Evidence: ${N(sizes.length)} rows with token counts`);
      }
    }

    if(ds.length>=8){
      const split=Math.floor(ds.length/2),early=ds.slice(0,split),late=ds.slice(split);
      const e=early.reduce((a,x)=>a+x[1].cost,0)/early.length;
      const l=late.reduce((a,x)=>a+x[1].cost,0)/late.length;
      if(e>0&&l>=e*1.6&&l-e>=1){
        add(82,"warn","Project daily spend is trending upward",
          `Average spend per observed day increased from ${usd(e)} to ${usd(l)} (${(l/e).toFixed(1)}×) between the earlier and later parts of the period. Check for workload growth before adjusting the budget.`,
          `Compared ${N(early.length)} earlier and ${N(late.length)} later observed days`);
      }
    }

    if(!candidates.length){
      add(20,"info","No strong anomaly found",
        `Reviewed ${N(ev.length)} returned activity rows for ${p.name}. The available data does not show a strong model-concentration, daily-spike, large-request or upward-trend signal.`,
        `Recorded spend: ${usd(p.cost)}`);
    }

    candidates.sort((a,b)=>b.score-a.score);
    candidates.slice(0,2).forEach(r=>all.push({...r,project:p.name,cost:p.cost}));
  }

  all.sort((a,b)=>b.score-a.score);
  const chosen=all.slice(0,1);
  if(!chosen.length){
    host.innerHTML='<div class="muted">No billable project activity to analyse.</div>';
    return;
  }
  host.innerHTML=chosen.map(r=>`<div class="airec-i ${r.tone}"><div><b>${esc(r.project)} · ${esc(r.title)}</b><p>${esc(r.text)}</p><em>${esc(r.tag)} · Project spend ${usd(r.cost)}</em></div></div>`).join("");
}

function userRecs(u,ev){
  const total=ev.reduce((a,x)=>{
    a.cost+=Math.max(0,+x.cost||0);
    a.tokens+=Math.max(0,+x.tokens||0);
    return a;
  },{cost:0,tokens:0});

  if(!ev.length||total.cost<=0){
    return [{tone:"info",title:"Not enough billable activity",
      text:`${nm(u)} has no billable usage in the selected period. Review a longer period before drawing optimisation conclusions.`,
      tag:"Evidence: selected period"}];
  }

  const recs=[];
  const add=(score,r)=>recs.push({...r,score});
  const share=(value)=>total.cost>0?value/total.cost:0;

  // Build evidence directly from this user's recorded activity.
  const byModel=new Map(),byProject=new Map(),byDay=new Map();
  for(const x of ev){
    const cost=Math.max(0,+x.cost||0);
    const tokens=Math.max(0,+x.tokens||0);
    const model=String(x.model||"Unknown").trim();
    const project=String(x.project||"Unknown Project").trim();
    const day=String(x.time||"").slice(0,10);

    if(!/^unknown/i.test(model)){
      const m=byModel.get(model)||{name:model,cost:0,tokens:0,rows:0};
      m.cost+=cost;m.tokens+=tokens;m.rows++;byModel.set(model,m);
    }
    const pr=byProject.get(project)||{name:project,cost:0,tokens:0,rows:0};
    pr.cost+=cost;pr.tokens+=tokens;pr.rows++;byProject.set(project,pr);
    if(day){
      const d=byDay.get(day)||{cost:0,rows:0,tokens:0};
      d.cost+=cost;d.rows++;d.tokens+=tokens;byDay.set(day,d);
    }
  }

  const models=[...byModel.values()].sort((a,b)=>b.cost-a.cost);
  const projects=[...byProject.values()].sort((a,b)=>b.cost-a.cost);
  const days=[...byDay.entries()].sort((a,b)=>a[0].localeCompare(b[0]));

  // Story 1: identify whether one model dominates this user's spend.
  if(models.length){
    const top=models[0],modelShare=share(top.cost);
    if(models.length>=2&&modelShare>=.65){
      add(85,{tone:"warn",title:"One model drives most of this user's cost",
        text:`${top.name} accounts for ${P(modelShare)} of ${nm(u)}'s recorded spend (${usd(top.cost)} across ${N(top.rows)} activity rows). Review a sample of routine tasks on this model and check whether a less expensive model already used by this user meets the same quality requirements.`,
        tag:`Evidence: ${top.name} · ${N(top.rows)} rows · ${usd(top.cost)}`});
    }else if(models.length===1&&modelShare>=.8){
      add(68,{tone:"info",title:"Single-model usage leaves little cost flexibility",
        text:`All identifiable model spend is concentrated in ${top.name} (${usd(top.cost)}). If this user handles both simple and complex tasks, evaluate a lighter model for routine work before changing the default.`,
        tag:"Recommendation to evaluate, not an automatic model change"});
    }

    if(models.length>=2){
      const ranked=[...models].filter(m=>m.tokens>0).map(m=>({...m,per1k:m.cost/(m.tokens/1000)})).filter(m=>m.per1k>0).sort((a,b)=>a.per1k-b.per1k);
      if(ranked.length>=2){
        const low=ranked[0],high=ranked[ranked.length-1];
        if(high.name!==low.name&&high.per1k/low.per1k>=3&&share(high.cost)>=.2){
          add(78,{tone:"good",title:"Compare expensive-model tasks with a cheaper alternative",
            text:`${high.name} costs about ${(high.per1k/low.per1k).toFixed(1)}× as much per 1,000 recorded tokens as ${low.name} for this user's observed usage. Review task types and output quality before moving suitable routine requests; the cost difference alone does not prove the models are interchangeable.`,
            tag:`Observed cost per 1K tokens: ${usd(high.per1k)} vs ${usd(low.per1k)}`});
        }
      }
    }
  }

  // Story 2: look for this user's own unusually large requests.
  const sizes=ev.map(x=>Math.max(0,+x.tokens||0)).filter(x=>x>0).sort((a,b)=>a-b);
  if(sizes.length>=8){
    const median=sizes.length%2?sizes[Math.floor(sizes.length/2)]:(sizes[sizes.length/2-1]+sizes[sizes.length/2])/2;
    const avg=sizes.reduce((a,b)=>a+b,0)/sizes.length;
    const largest=sizes[sizes.length-1];
    if(median>0&&avg>=median*2.5&&largest>=median*4){
      add(90,{tone:"warn",title:"A small number of large requests may be inflating token use",
        text:`${nm(u)}'s average recorded request is ${fmt(avg)} tokens, versus a median of ${fmt(median)}; the largest is ${fmt(largest)}. Inspect the largest requests for long context, repeated instructions or oversized documents before changing model settings.`,
        tag:`Evidence: ${N(sizes.length)} rows with token counts`});
    }
  }

  // Story 3: compare the user's busiest day with their typical observed day.
  if(days.length>=5){
    const daily=days.map(([,v])=>v.cost).sort((a,b)=>a-b);
    const mid=daily.length%2?daily[Math.floor(daily.length/2)]:(daily[daily.length/2-1]+daily[daily.length/2])/2;
    const peak=days.reduce((best,item)=>item[1].cost>best[1].cost?item:best,days[0]);
    if(mid>0&&peak[1].cost>=mid*2.5){
      add(95,{tone:"bad",title:"Investigate this user's spending spike",
        text:`Spend on ${peak[0]} reached ${usd(peak[1].cost)}, about ${(peak[1].cost/mid).toFixed(1)}× the median spend across observed active days. Check what ran that day for a batch job, retry loop or unusually heavy workload before treating it as waste.`,
        tag:"Evidence: daily spend in the selected period"});
    }
  }

  // Story 4: highlight project concentration only when it is meaningful.
  if(projects.length>=2){
    const top=projects[0],pct=share(top.cost);
    if(pct>=.75){
      add(72,{tone:"info",title:"Most of this user's spend belongs to one project",
        text:`${top.name} accounts for ${P(pct)} of ${nm(u)}'s spend (${usd(top.cost)}). Check whether this reflects the user's expected assignment and whether the project budget is appropriate for that workload.`,
        tag:`Evidence: ${N(top.rows)} activity rows in ${top.name}`});
    }
  }

  // Story 5: compare early and late observed days for a meaningful trend.
  if(days.length>=8){
    const split=Math.floor(days.length/2);
    const early=days.slice(0,split),late=days.slice(split);
    const avgEarly=early.reduce((a,x)=>a+x[1].cost,0)/early.length;
    const avgLate=late.reduce((a,x)=>a+x[1].cost,0)/late.length;
    if(avgEarly>0&&avgLate>=avgEarly*1.6&&avgLate-avgEarly>=1){
      add(82,{tone:"warn",title:"This user's daily spend is trending upward",
        text:`Average spend per observed day increased from ${usd(avgEarly)} in the earlier part of the period to ${usd(avgLate)} in the later part (${(avgLate/avgEarly).toFixed(1)}×). Check for a new workload, larger prompts or increased usage frequency before adjusting budgets.`,
        tag:`Compared ${N(early.length)} earlier with ${N(late.length)} later observed days`});
    }
  }

  recs.sort((a,b)=>b.score-a.score);
  if(!recs.length){
    const busiest=models[0];
    return [{tone:"good",title:"No strong cost anomaly found",
      text:`Reviewed ${N(ev.length)} returned activity rows for ${nm(u)}. The available evidence does not show a strong model-cost, request-size, daily-spike or project-concentration signal. Continue monitoring as usage changes.`,
      tag:busiest?`Largest model by spend: ${busiest.name} (${usd(busiest.cost)})`:"Evidence: selected period"}];
  }
  return recs.slice(0,1).map(({score,...r})=>r);
}

