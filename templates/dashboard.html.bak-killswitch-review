        "Content-Type": "application/json",
        "Authorization": "Bearer " + await user.getIdToken()
      },
      credentials: "same-origin",
      body: "{}"
    });
  } catch (e) {
    console.warn("Could not activate a pending dashboard role", e);
  }
  await load();
  });
})();

