// AI_FINOPS_ACCESS_DENIED_GATE_V1
// Display a clear denial screen when the backend confirms that the
// authenticated user has no active dashboard role.
(function installAccessDeniedGate() {
  let deniedScreenShown = false;
  const originalFetch = window.fetch.bind(window);

  function showDashboardAccessDenied() {
    if (deniedScreenShown) return;
    deniedScreenShown = true;

    let screen = document.getElementById("dashboardAccessDenied");
    if (!screen) {
      screen = document.createElement("div");
      screen.id = "dashboardAccessDenied";
      screen.setAttribute("role", "alert");
      screen.setAttribute("aria-live", "assertive");
      screen.style.cssText = [
        "position:fixed", "inset:0", "z-index:2147483647",
        "display:flex", "align-items:center", "justify-content:center",
        "padding:24px", "background:#f4f7fb", "color:#172033",
        "font-family:system-ui,-apple-system,BlinkMacSystemFont,Segoe UI,sans-serif"
      ].join(";");

      const panel = document.createElement("div");
      panel.style.cssText =
        "width:min(100%,480px);box-sizing:border-box;background:#fff;" +
        "border:1px solid #dce3ec;border-radius:16px;padding:32px;" +
        "box-shadow:0 18px 55px rgba(15,23,42,.12);text-align:center";

      const icon = document.createElement("div");
      icon.textContent = "403";
      icon.style.cssText =
        "font-size:42px;font-weight:800;letter-spacing:-2px;color:#b42318;margin-bottom:12px";

      const heading = document.createElement("h1");
      heading.textContent = "Access Denied";
      heading.style.cssText = "font-size:25px;margin:0 0 12px";

      const message = document.createElement("p");
      message.textContent =
        "Access to the AI FinOps Dashboard is denied. Please contact your Administrator to request access.";
      message.style.cssText =
        "font-size:15px;line-height:1.65;color:#526176;margin:0 0 24px";

      const signOut = document.createElement("button");
      signOut.type = "button";
      signOut.textContent = "Return to sign in";
      signOut.style.cssText =
        "border:0;border-radius:8px;padding:11px 22px;background:#172033;" +
        "color:white;font-size:14px;font-weight:650;cursor:pointer";
      signOut.addEventListener("click", async () => {
        signOut.disabled = true;
        signOut.textContent = "Signing out…";
        try {
          await firebase.auth().signOut();
        } finally {
          window.location.reload();
        }
      });

      panel.append(icon, heading, message, signOut);
      screen.appendChild(panel);
      document.body.appendChild(screen);
    }

    // A 403 role denial must not leave an unauthorized Firebase session active.
    if (window.firebase && firebase.auth) {
      firebase.auth().signOut().catch(error => {
        console.error("Could not sign out unauthorized account", error);
      });
    }
  }

  window.fetch = async function(input, init) {
    const response = await originalFetch(input, init);

    try {
      const rawUrl = typeof input === "string"
        ? input
        : (input && input.url) || "";
      const pathname = new URL(rawUrl, window.location.origin).pathname;

      if (pathname.startsWith("/api/") && response.status === 403) {
        const body = await response.clone().json();
        if (body && body.error === "dashboard_role_required") {
          showDashboardAccessDenied();
        }
      }
    } catch (e) {
      // Preserve the original response even if the response isn't JSON.
    }

    return response;
  };
})();

