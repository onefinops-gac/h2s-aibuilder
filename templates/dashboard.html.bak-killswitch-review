      drawW(h.dataset.id);
      saveLayout();
    }else if(go){
      S.sel=null;
      setView(go.dataset.go);
    }
  });

  return true;
}

/* ================= TABLES ================= */
function table(id,cols,rows,sk,onRow){
  const el=$("#"+id);
  const st=S.sort[id]||{k:sk,d:-1};
  const q=(S.q[id]||"").toLowerCase();
  const lim=S.lim[id]||12;

  let r=rows.filter(x=>!q||String(x[cols[0].k]).toLowerCase().includes(q));
  r=[...r].sort((a,b)=>(typeof a[st.k]==="string"?a[st.k].localeCompare(b[st.k]):a[st.k]-b[st.k])*st.d);

  const sc=cols.find(c=>c.share);
  const tt=sc?rows.reduce((a,x)=>a+(+x[sc.k]||0),0)||1:1;
  const sh=r.slice(0,lim);

  el.innerHTML=`
    <thead><tr>${cols.map(c=>`
      <th class="${c.r?"r":""}" data-k="${c.k}" scope="col">${c.l}<span class="ar">${st.k===c.k?(st.d>0?"↑":"↓"):""}</span></th>`).join("")}
    </tr></thead>
    <tbody>
      ${sh.map(x=>`<tr class="${onRow?"cl":""}">${cols.map(c=>{
        const v=x[c.k];
        if(c.share)return`<td class="r"><div class="share"><b>${usd(v)}</b><i><u style="width:${Math.min(100,v/tt*100)}%"></u></i></div></td>`;
        return`<td class="${c.r?"r":""} ${c.c||""}" ${c.f?"":`title="${esc(v)}"`}>${c.f?c.f(v,x):esc(v)}</td>`;
      }).join("")}</tr>`).join("")}
      ${r.length>lim?`<tr class="more"><td colspan="${cols.length}"><button class="link">Show more (${r.length-lim} remaining)</button></td></tr>`:""}
    </tbody>`;

  el.querySelectorAll("th").forEach(h=>h.onclick=()=>{
    const k=h.dataset.k,c=S.sort[id]||{k:sk,d:-1};
    S.sort[id]={k,d:c.k===k?-c.d:-1};
    table(id,cols,rows,sk,onRow);
  });

  const mb=el.querySelector(".more .link");
  if(mb)mb.onclick=()=>{S.lim[id]=lim+25;table(id,cols,rows,sk,onRow)};

