/* ================= DATA LAYER ================= */
async function api(path,ms){
  try{
    const headers={};
    let user=window.firebase && firebase.apps && firebase.apps.length
      ? firebase.auth().currentUser : null;
    if(!user && window.firebase && firebase.apps && firebase.apps.length){
      user=await new Promise(resolve=>{
        let unsubscribe=null;
        unsubscribe=firebase.auth().onAuthStateChanged(
          u=>{if(unsubscribe)unsubscribe();resolve(u);},
          ()=>resolve(null)
        );
      });
    }
    if(user){
      headers.Authorization="Bearer "+await user.getIdToken();
    }
    const r=await fetch("/api/"+path,{cache:"no-store",headers,signal:ms?AbortSignal.timeout(ms):undefined});
    if(r.status===404)return{nf:1};
    if(r.status===401)return{err:"AUTH_REQUIRED"};
    if(!r.ok){
      let m="";
      try{const j=await r.json();m=j.message||j.error||""}catch(e){}
      return{err:"HTTP "+r.status+(m?" - "+m:"")};
    }
    return{data:await r.json()};
  }catch(e){
    return{err:e&&(e.name==="TimeoutError"||e.name==="AbortError")?"TIMEOUT":"NETWORK_ERROR"};
  }
}

const rnd=s=>()=>(s=(s*16807)%2147483647)/2147483647;
const MS=[["gemini-3.8-flash",1.2],["gemini-2.5-pro",5],["gemini-2.5-flash",.9],["gemini-3.1-pro-preview",7],["gemini-2.0-flash",.3],["gemini-2.5-flash-lite",.2]];

function demoRows(){
  const r=rnd(5);
  const US=["alice.tan","ben.lim","chloe.ng","daniel.koh","emily.wong","farid.ali","grace.lee","henry.goh","ivy.chen","jack.ong","kim.seah","leo.yap"];
  const PJ=["ai-platform-prod","customer-insights","doc-intelligence","hr-assistant","fraud-lab"];
  const out=[];
  US.forEach((u,i)=>[i%5,(i+2)%5,(i+3)%5].forEach((mi,k)=>{
    const t=(5+r()*12)*1e6*(1.7-i*.1)/(k+1),inp=t*.68;
    out.push({
      user_principal:u+"@company.com",project_id:PJ[(i+k)%5],model:MS[mi][0],
      prompt_tokens:inp,completion_tokens:t*.26,thoughts_tokens:t*.06,
      cached_content_tokens:inp*(.08+r()*.3),total_tokens:t,
      request_count:Math.round(t/5200),estimated_cost_usd:t/1e6*MS[mi][1]
    });
  }));
  return out;
}

function demoApi(path){
  const[p,qs]=path.split("?"),q=new URLSearchParams(qs||""),per=q.get("period")||"monthly";
  const now0=new Date(),dim=new Date(now0.getFullYear(),now0.getMonth()+1,0).getDate();
  const e=(now0.getDate()-1+now0.getHours()/24)/dim;
  const f={daily:Math.max(.1,now0.getHours()/24)/dim,monthly:Math.max(.05,e),yearly:now0.getMonth()+e}[per]||1;
  const base=demoRows(),r=rnd(9);
  const mt=base.reduce((a,x)=>a+x.estimated_cost_usd,0),mk=base.reduce((a,x)=>a+x.total_tokens,0);

  if(p==="reports"){
    const dimension=q.get("dimension")||"user";
    const rows=base.map(x=>({
      ...x,
      prompt_tokens:Math.round((+x.prompt_tokens||0)*f),
      cached_content_tokens:Math.round((+x.cached_content_tokens||0)*f),
      completion_tokens:Math.round((+x.completion_tokens||0)*f),
      thoughts_tokens:Math.round((+x.thoughts_tokens||0)*f),
      total_tokens:Math.round((+x.total_tokens||0)*f),
      request_count:Math.round((+x.request_count||0)*f),
      estimated_cost_usd:(+x.estimated_cost_usd||0)*f
    }));
    const summary={
      estimated_cost_usd:0,total_tokens:0,prompt_tokens:0,
      cached_content_tokens:0,completion_tokens:0,thoughts_tokens:0,
      tool_use_prompt_tokens:0,requests:0,
      active_users:new Set(),active_projects:new Set(),active_models:new Set()
    };
    const grouped={};
    for(const x of rows){
      const user=x.user_principal||"Unknown User";
      const project=x.project_id||"Unknown Project";
      const model=x.model||"unknown";
      const cost=+x.estimated_cost_usd||0;
      const tokens=+x.total_tokens||0;
      const requests=+x.request_count||0;
      summary.estimated_cost_usd+=cost;
      summary.total_tokens+=tokens;
      summary.prompt_tokens+=+x.prompt_tokens||0;
      summary.cached_content_tokens+=+x.cached_content_tokens||0;
      summary.completion_tokens+=+x.completion_tokens||0;
      summary.thoughts_tokens+=+x.thoughts_tokens||0;
      summary.tool_use_prompt_tokens+=+x.tool_use_prompt_tokens||0;
      summary.requests+=requests;
      if(user&&!/^unknown/i.test(user))summary.active_users.add(user);
      if(project&&!/^unknown/i.test(project))summary.active_projects.add(project);
      if(model&&!/^unknown/i.test(model))summary.active_models.add(model);

      if(dimension==="token"){
        for(const [name,count] of [
          ["Input tokens",+x.prompt_tokens||0],
          ["Cached input tokens",+x.cached_content_tokens||0],
          ["Output tokens",+x.completion_tokens||0],
          ["Thought tokens",+x.thoughts_tokens||0]
        ]){
          const row=grouped[name]||(grouped[name]={name,tokens:0});
          row.tokens+=count;
        }
      }else{
        const name=dimension==="project"?project:dimension==="model"?model:user;
        const row=grouped[name]||(grouped[name]={
          name,estimated_cost_usd:0,tokens:0,requests:0,
          input_tokens:0,cached_tokens:0,output_tokens:0,thoughts_tokens:0
        });
        row.estimated_cost_usd+=cost;
        row.tokens+=tokens;
        row.requests+=requests;
        row.input_tokens+=+x.prompt_tokens||0;
        row.cached_tokens+=+x.cached_content_tokens||0;
        row.output_tokens+=+x.completion_tokens||0;
        row.thoughts_tokens+=+x.thoughts_tokens||0;
      }
    }
    summary.active_users=summary.active_users.size;
    summary.active_projects=summary.active_projects.size;
    summary.active_models=summary.active_models.size;
    const resultRows=Object.values(grouped).sort(
      (a,b)=>(b.estimated_cost_usd??b.tokens??0)-(a.estimated_cost_usd??a.tokens??0)
    );
    return {period:per,dimension,summary,rows:resultRows};
  }

  if(p==="users")return base.map(x=>({...x,
    prompt_tokens:x.prompt_tokens*f,completion_tokens:x.completion_tokens*f,thoughts_tokens:x.thoughts_tokens*f,
    cached_content_tokens:x.cached_content_tokens*f,total_tokens:x.total_tokens*f,
    request_count:Math.round(x.request_count*f),estimated_cost_usd:x.estimated_cost_usd*f}));

  if(p==="trend"){
    const n={daily:30,monthly:12,yearly:5}[per];
    const unit=mt*{daily:1/30,monthly:1,yearly:10}[per],now=new Date();
    return Array.from({length:n},(_,i)=>{
      const d=n-1-i,dt=new Date(now);let label;
      if(per==="daily"){dt.setDate(dt.getDate()-d);label=dt.getDate()+" "+dt.toLocaleString("en",{month:"short"})}
      else if(per==="monthly"){dt.setMonth(dt.getMonth()-d);label=dt.toLocaleString("en",{month:"short",year:"2-digit"})}
      else label=String(now.getFullYear()-d);
      const c=unit*(.6+r()*.5)*(.7+.3*i/n),t=c*mk/mt;
      return{label,estimated_cost:c,total_tokens:t,request_count:t/5200};
    });
  }

  if(p==="requests")return Array.from({length:12},(_,i)=>{
    const x=base[(i*5)%base.length],t=2000+i*811;
    return{
      event_timestamp:new Date(Date.now()-i*41*6e4).toISOString(),user_principal:x.user_principal,
      project_id:x.project_id,model:x.model,authentication_type:i%3?"OAUTH":"SERVICE_ACCOUNT",
      total_tokens:t,estimated_cost_usd:t/1e6*MS.find(m=>m[0]===x.model)[1]
    };
  });

  if(p==="user-detail"){
    const u=q.get("user"),mine=base.filter(x=>x.user_principal===u);
    return Array.from({length:40},(_,i)=>{
      const x=mine[i%(mine.length||1)]||base[0],t=1500+(i*977)%9000;
      return{
        event_timestamp:new Date(Date.now()-i*(per==="daily"?18:per==="monthly"?7:52)*36e5).toISOString(),
        project_id:x.project_id,model:x.model,authentication_type:"OAUTH",
        prompt_tokens:t*.7,completion_tokens:t*.3,total_tokens:t,
        estimated_cost_usd:t/1e6*MS.find(m=>m[0]===x.model)[1]
      };
    });
  }
  return null;
}

async function get(path){
  if(S.demo)return{data:demoApi(path)};
  return api(path);
}

const norm=r=>({
  user:r.user_principal||"Unknown User",project:r.project_id||"Unknown Project",model:r.model||"unknown",
  inp:+r.prompt_tokens||0,cached:+r.cached_content_tokens||0,comp:+r.completion_tokens||0,th:+r.thoughts_tokens||0,
  tokens:+r.total_tokens||0,requests:+r.request_count||0,cost:+r.estimated_cost_usd||0
});

const tot=rs=>rs.reduce((a,r)=>{
  a.cost+=r.cost;a.tokens+=r.tokens;a.requests+=r.requests;a.inp+=r.inp;a.cached+=r.cached;a.comp+=r.comp;a.th+=r.th;return a;
},{cost:0,tokens:0,requests:0,inp:0,cached:0,comp:0,th:0});

function agg(k,rs){
  rs=rs||S.rows;
  const m=new Map();
  rs.forEach(r=>{
    let x=m.get(r[k]);
    if(!x){x={name:r[k],cost:0,tokens:0,requests:0,inp:0,cached:0,U:new Set(),P:new Set(),M:new Set()};m.set(r[k],x)}
    x.cost+=r.cost;x.tokens+=r.tokens;x.requests+=r.requests;x.inp+=r.inp;x.cached+=r.cached;
    x.U.add(r.user);x.P.add(r.project);x.M.add(r.model);
  });
  return[...m.values()].map(x=>({...x,
    users:x.U.size,projects:x.P.size,models:x.M.size,
    avg:x.requests?x.tokens/x.requests:0,hit:x.inp?x.cached/x.inp:0,per1k:x.tokens?x.cost/x.tokens*1000:0
  })).sort((a,b)=>b.cost-a.cost);
}
const real=k=>agg(k).filter(x=>!/^unknown/i.test(x.name));

function proj(){
  if(projDone())return 1;
  const n=new Date();let f;
  if(S.p==="daily")f=Math.max(.1,(n.getHours()+n.getMinutes()/60)/24);
  else if(S.p==="monthly")f=Math.max(.03,(n.getDate()-1+n.getHours()/24)/new Date(n.getFullYear(),n.getMonth()+1,0).getDate());
  else f=Math.max(.03,(n-new Date(n.getFullYear(),0,1))/(new Date(n.getFullYear()+1,0,1)-new Date(n.getFullYear(),0,1)));
  return f;
}

async function load(){
  if(S.busy)return;
  S.busy=true;
  ksFetch();   // start now, in parallel with users/trend/requests (was waiting for them)

  if(S.demo===null){
    const h=await api("health"),el=$("#ssrc");
    S.demo=!!h.nf && !h.err;
    $("#sdot").className="dot"+(S.demo?" demo":"");
    $("#stext").textContent=S.demo?"Sample data":"Live telemetry";
    el.textContent=S.demo?"Preview mode":"Vertex AI usage \u00b7 Asia/Singapore";
    $("#demo").classList.toggle("hidden",!S.demo);
  }

  $("#err").classList.add("hidden");
  const[u,t,a]=await Promise.all(["users?"+selQS(),"trend?"+selQS(),"requests"].map(get));
  S.busy=false;

  if(u.err||!u.data){
    $("#errm").textContent=u.err||"No response from /api/users";
    $("#err").classList.remove("hidden");
    return;
  }

  S.rows=u.data.map(norm);
  S.trend=t.data||[];
  S.act=(a.data||[]).map(x=>({
    time:x.event_timestamp,user:x.user_principal||"",project:x.project_id,model:x.model,
    tokens:+x.total_tokens||0,cost:+x.estimated_cost_usd||0
  }));
  S.loaded=true;
  render();
}

