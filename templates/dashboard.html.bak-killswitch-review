function ksRecommendations(rows,t,events){
  const host=$("#ksRecList");
  if(!host)return;

  const escText=v=>String(v).replace(/[&<>"']/g,c=>({
    "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
  }[c]));

  const projects=(rows||[]).map(p=>({
    ...p,
    name:String(p.name||"Project"),
    util:Math.max(0,+p.util||0),
    spend:Math.max(0,+p.spend||0),
    budget:Math.max(0,+p.budget||0),
    state:String(p.state||"armed").toLowerCase()
  }));

  const latest={};
  (events||[]).forEach(e=>{
    if(!e.project_id)return;
    const old=latest[e.project_id];
    if(!old||String(e.ts||"")>String(old.ts||""))latest[e.project_id]=e;
  });

  const recs=[];
  const add=(score,tone,title,body,action,key)=>recs.push({
    score,tone,title,body,action,key
  });

  // Highest-priority findings come from current budget state, not event count.
  const ranked=[...projects].sort((a,b)=>b.util-a.util);
  const critical=ranked.filter(p=>p.state==="tripped"||p.util>=t);
  const near=ranked.filter(p=>p.state!=="tripped"&&p.util<t&&p.util>=.75);

  critical.slice(0,2).forEach((p,i)=>{
    const pct=Math.round(p.util*100);
    const hasSim=!!(latest[p.name]&&latest[p.name].simulated);
    add(
      120-i,
      "bad",
      i===0?"Critical budget risk":"Additional budget risk",
      `${p.name} is at ${pct}% budget utilization${p.budget>0?` (${usd(p.spend)} spent of ${usd(p.budget)})`:""}. ${hasSim?"A simulated event is recorded; verify the current budget figures and event history.":"Verify the current budget figures and trigger status."}`,
      "Priority: verify current budget and usage",
      "risk:"+p.name
    );
  });

  if(!critical.length&&near.length){
    const p=near[0];
    add(
      90,"warn","Project approaching trigger",
      `${p.name} has used ${Math.round(p.util*100)}% of its budget${p.budget>0?` (${usd(p.spend)} of ${usd(p.budget)})`:""}. Review recent daily spend and expected remaining usage before it reaches the ${Math.round(t*100)}% trigger.`,
      "Review spend trajectory",
      "near:"+p.name
    );
  }

  // Include one event finding only if it adds information beyond current risk.
  const eventList=Object.values(latest).sort((a,b)=>
    String(b.ts||"").localeCompare(String(a.ts||""))
  );
  const recovered=eventList.find(e=>
    e.simulated&&String(e.type||"").toLowerCase()==="recovered"
  );
  const triggered=eventList.find(e=>
    e.simulated&&String(e.type||"").toLowerCase()==="tripped"&&
    !recs.some(r=>r.key==="risk:"+e.project_id)
  );

  if(recovered){
    add(
      75,"info","Verify simulated recovery",
      `${recovered.project_id} has a recorded simulated recovery. Confirm its current utilization is below the configured trigger and that the event history matches the current status. No real control was changed by this simulated event.`,
      "Verify recovery and current status",
      "recovered:"+recovered.project_id
    );
  }else if(triggered){
    add(
      70,"info","Verify simulated trigger history",
      `${triggered.project_id} has a recorded simulated trigger but is not among the highest current budget risks. Check whether its latest event agrees with its current utilization and status. No real control was changed by this simulated event.`,
      "Compare event history with current status",
      "event:"+triggered.project_id
    );
  }

  // If fewer than three findings exist, use the next distinct current risk.
  for(const p of [...near,...ranked.filter(p=>p.util>=.5&&p.util<.75)]){
    if(recs.length>=3)break;
    if(recs.some(r=>r.key.endsWith(":"+p.name)))continue;
    add(
      p.util>=.5?60:30,
      p.util>=.5?"warn":"info",
      p.util>=.5?"Monitor budget trajectory":"Budget status healthy",
      `${p.name} is at ${Math.round(p.util*100)}% budget utilization${p.budget>0?` (${usd(p.spend)} of ${usd(p.budget)})`:""}. ${p.util>=.5?"Monitor usage and expected remaining spend.":"No immediate budget action is indicated; continue routine monitoring."}`,
      p.util>=.5?"Monitor expected spend":"Routine monitoring",
      "status:"+p.name
    );
  }

  recs.sort((a,b)=>b.score-a.score);
  const chosen=recs.slice(0,1);

  if(!chosen.length){
    host.innerHTML='<div class="airec-list"><div class="airec-i info"><div><b>No immediate budget-risk signal</b><p>No projects currently meet the review thresholds. Continue monitoring spending and usage trends.</p><em>Advisory only</em></div></div></div>';
    return;
  }

  host.innerHTML='<div class="airec-list">'+chosen.map(r=>
    '<div class="airec-i '+r.tone+'"><div><b>'+
    escText(r.title)+'</b><p>'+escText(r.body)+'</p><em>'+
    escText(r.action)+'</em></div></div>'
  ).join("")+'</div>';
}

