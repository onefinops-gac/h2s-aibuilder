    const r=await fetch("/api/advisor/ask",{method:"POST",headers:await advAuthHeaders(),body:JSON.stringify(body),signal:AbortSignal.timeout(45000)});
    const j=await r.json().catch(()=>({}));
    if(r.ok)AP.msgs.push({role:"advisor",text:j.answer||"No answer returned.",range:j.data_range,suggest:j.suggestions});
    else AP.msgs.push({role:"advisor",text:r.status===404?"The advisor is not available on this server.":(j.error||j.message||"The advisor is unavailable right now (HTTP "+r.status+").")});
  }catch(e){AP.msgs.push({role:"advisor",text:e.name==="TimeoutError"||e.name==="AbortError"?"The advisor request timed out after 45 seconds. Please try again.":"Could not reach the advisor: "+(e.message||"connection error")})}
