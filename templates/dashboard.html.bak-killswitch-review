async function advAuthHeaders(){
  const h={"Content-Type":"application/json"};
  if(window.firebase&&firebase.apps&&firebase.apps.length){
    let u=firebase.auth().currentUser;
    if(!u){
      u=await new Promise(resolve=>{
        let unsub=null,done=false;
        const finish=value=>{
          if(done)return;
          done=true;
          if(unsub)unsub();
          resolve(value);
        };
        unsub=firebase.auth().onAuthStateChanged(finish,()=>finish(null));
        setTimeout(()=>finish(firebase.auth().currentUser),5000);
      });
    }
    if(u)h.Authorization="Bearer "+await u.getIdToken();
  }
  return h;
}

