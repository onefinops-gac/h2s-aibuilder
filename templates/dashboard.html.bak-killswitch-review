function advMd(t){
  const inl=x=>esc(x).replace(/\*\*(.+?)\*\*/g,"<strong>$1</strong>");
  let h="",ul=false,para=[];
  const flush=()=>{if(para.length){h+="<p>"+para.map(inl).join("<br>")+"</p>";para=[]}};
  const close=()=>{if(ul){h+="</ul>";ul=false}};
  for(const raw of String(t||"").split(/\r?\n/)){
    const l=raw.trim();
    if(!l){flush();close();continue}
    const m=l.match(/^(?:[•\-*]|\d+[.)])\s+(.*)$/);
    if(m){flush();if(!ul){h+="<ul>";ul=true}h+="<li>"+inl(m[1])+"</li>";continue}
    if(l.startsWith("→")){flush();close();h+='<span class="rec">'+inl(l.replace(/^→\s*/,""))+"</span>";continue}
    close();para.push(l);
  }
  flush();close();return h;
}
