function drawW(id){
  const i=W[id];
  if(!i||!i.el||!S.loaded)return;
  const o=WG[i.type],b=i.el.querySelector(".wb");
  let sub="";
  try{sub=o.draw(b,i,id)||""}
  catch(e){killChart(id);b.innerHTML=empty("Couldn't render this widget",esc(e.message))}
  i.el.querySelector(".ws").textContent=sub;
  i.el.querySelector(".wc").innerHTML=o.ctl?o.ctl(i):"";
}

const drawAll=()=>Object.keys(W).forEach(drawW);

function addW(type,pos,id,cfg){
  const o=WG[type];
  id=id||type+"-"+Math.random().toString(36).slice(2,7);
  W[id]={type,cfg:cfg||{...(o.cfg||{})}};
  const el=grid.addWidget({id,w:o.w,h:o.h,minW:o.minW||2,minH:o.minH||2,content:shell(id,type),...(pos||{})});
  W[id].el=el;
  {const c=el.querySelector(".grid-stack-item-content");if(c){c.dataset.type=type;if(o.g==="kpi")c.dataset.kpi="1"}}
  drawW(id);
  return el;
}

function rmW(id){
  const i=W[id];
  if(!i)return;
  killChart(id);
  delete W[id];
  grid.removeWidget(i.el);
  saveLayout();
}

function saveLayout(){
  updateEmpty();
  if(loading||!grid||grid.getColumn()!==12)return;
  const l=grid.save(false).filter(n=>W[n.id]).map(n=>({id:n.id,type:W[n.id].type,cfg:W[n.id].cfg,x:n.x,y:n.y,w:n.w,h:n.h}));
  try{localStorage.setItem(LKEY,JSON.stringify(l))}catch(e){}
}

const updateEmpty=()=>$("#gempty").classList.toggle("hidden",Object.keys(W).length>0);

function build(layout){
  loading=true;
  Object.keys(W).forEach(killChart);
  W={};
  grid.removeAll(true);
  grid.batchUpdate();
  layout.forEach(n=>addW(n.type,{x:n.x,y:n.y,w:n.w,h:n.h},n.id,n.cfg));
  grid.commit();
  loading=false;
  updateEmpty();
}

