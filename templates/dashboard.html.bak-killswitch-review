function reportDateParams(){
  const period = document.getElementById("reportPeriod")?.value || "monthly";
  if(period !== "custom") return "";
  const start = document.getElementById("reportStartDate")?.value || "";
  const end = document.getElementById("reportEndDate")?.value || "";
  if(!start || !end) return null;
  if(start > end) throw new Error("Start date must be on or before end date.");
  return "&start_date=" + encodeURIComponent(start) +
         "&end_date=" + encodeURIComponent(end);
}
async function loadReports(){
  const period = document.getElementById("reportPeriod")?.value || "monthly";
  const dimension = document.getElementById("reportDimension")?.value || "user";
  const custom = period === "custom";
  document.getElementById("reportCustomStartWrap").hidden = !custom;
  document.getElementById("reportCustomEndWrap").hidden = !custom;
  REPORT_STATE.period = period;
  REPORT_STATE.dimension = dimension;
  REPORT_STATE.loading = true;
  REPORT_STATE.error = "";
  const table = document.getElementById("reportTable");
  if(table) table.innerHTML = '<tbody><tr><td>Loading report…</td></tr></tbody>';

  try {
    const dateParams = reportDateParams();
    if(dateParams === null){
      REPORT_STATE.data = null;
      REPORT_STATE.error = "Choose both a start date and an end date.";
      return;
    }
    const response = await get(
      "reports?period=" + encodeURIComponent(period) +
      "&dimension=" + encodeURIComponent(dimension) + dateParams
    );
    const result = response?.data ?? response;
    if(!result || result.error) throw new Error(result?.error || "No report data returned.");
    REPORT_STATE.data = result;
  } catch(e) {
    REPORT_STATE.error = e?.message || "Unable to load report.";
    REPORT_STATE.data = null;
  } finally {
    REPORT_STATE.loading = false;
    renderReports();
  }
}
function renderReports(){
  const data = REPORT_STATE.data;
  const k = document.getElementById("reportKpis");
  const table = document.getElementById("reportTable");
  const dim = document.getElementById("reportDimension")?.value || "user";

  if(REPORT_STATE.loading) return;
  if(!data){
    if(k) k.innerHTML = "";
    if(table) table.innerHTML =
      `<tbody><tr><td>${esc(REPORT_STATE.error || "Select a reporting period to load data.")}</td></tr></tbody>`;
    return;
  }

  const summary = data.summary || {};
  const activeUsers = Number(summary.active_users || 0);
  if(k) k.innerHTML = [
    ["Estimated cost",reportMoney(summary.estimated_cost_usd),"Estimated spend"],
    ["Total tokens",reportNumber(summary.total_tokens),"Input, output and other counted tokens"],
    ["Requests",reportNumber(summary.requests),"Recorded requests"],
    ["Active users",reportNumber(activeUsers),"Distinct users with usage"]
  ].map(([a,b,c])=>`<div class="card pad"><span class="report-kpi-label">${esc(a)}</span><strong class="report-kpi-value">${esc(b)}</strong><span class="report-kpi-caption">${esc(c)}</span></div>`).join("");

  const periodBadge = document.getElementById("reportPeriodBadge");
  const periodSelect = document.getElementById("reportPeriod");
  const periodText = periodSelect?.selectedOptions?.[0]?.textContent || "Selected period";
  if(periodBadge) periodBadge.textContent = periodText;

  const rows = data.rows || [];
  const title = {
    user:"Usage by user",
    project:"Usage by project",
    model:"Usage by model",
    token:"Token category totals"
  }[dim] || "Usage report";

  const meta = document.getElementById("reportMeta");
  const titleNode = document.getElementById("reportTableTitle");
  if(titleNode) titleNode.textContent = title;
  if(meta) meta.textContent =
    `${data.start_date && data.end_date ? data.start_date + " – " + data.end_date : (data.period || REPORT_STATE.period)} · ${rows.length} rows · estimated costs`;

  if(!table) return;
  const headers = dim === "token"
    ? ["Token category","Tokens"]
    : ["Name","Estimated cost","Tokens","Requests"];

  table.innerHTML = "<thead><tr>" +
    headers.map(h=>`<th>${esc(h)}</th>`).join("") +
    "</tr></thead><tbody>" +
    (rows.length ? rows.map(r => "<tr>" +
      `<td>${esc(r.name)}</td>` +
      (dim === "token"
        ? `<td>${reportNumber(r.tokens)}</td>`
        : `<td>${reportMoney(r.estimated_cost_usd)}</td>` +
          `<td>${reportNumber(r.tokens)}</td>` +
          `<td>${reportNumber(r.requests)}</td>`) +
      "</tr>").join("")
      : `<tr><td colspan="${headers.length}">No usage data for this period.</td></tr>`) +
    "</tbody>";
}
function setReportPeriod(period){
  if(!["daily","monthly","yearly","custom"].includes(period)) return;
  loadReports();
}
function exportReportsCSV(){
  const data = REPORT_STATE.data;
  if(!data){
    alert("Load a report before exporting.");
    return;
  }
  const dim = REPORT_STATE.dimension;
  const rows = data.rows || [];
  const output = dim === "token"
    ? [["token_category","tokens"], ...rows.map(r=>[r.name,r.tokens])]
    : [["dimension","name","estimated_cost_usd","tokens","requests"],
       ...rows.map(r=>[dim,r.name,r.estimated_cost_usd,r.tokens,r.requests])];

  const csv = output.map(row=>row.map(v=>{
    const x=String(v??"");
    return '"' + x.replace(/"/g,'""') + '"';
  }).join(",")).join("\r\n");
  const blob = new Blob(["\uFEFF"+csv],{type:"text/csv;charset=utf-8"});
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = `ai_finops_report_${REPORT_STATE.period}_${dim}.csv`;
  a.click();
  setTimeout(()=>URL.revokeObjectURL(url),1000);
}


