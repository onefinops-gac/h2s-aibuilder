const ksLbl=v=>{v=String(v==null?"":v);return v==="tripped"?"Triggered":v==="armed"?"Active":cap(v)};
const ksTxt=t=>String(t==null?"":t).replace(/\bTripped\b/g,"Triggered").replace(/\btripped\b/g,"triggered").replace(/\bTrips\b/g,"Triggers").replace(/\btrips\b/g,"triggers").replace(/\btrip\b/g,"trigger");
const ksTone=s=>({tripped:"bad",armed:"good",recovering:"warn",simulated:"info"}[s]||"");
const ksCol=(u,t)=>u>=t?"var(--bad)":u>=KS_NEAR?"var(--warn)":"var(--good)";

const KS_CK="ks.status.v1";
let ksInflight=null;
const ksCacheKey=()=>{const u=window.firebase&&firebase.apps&&firebase.apps.length?firebase.auth().currentUser:null;return KS_CK+":"+(u?u.uid:"anon")};
/* paint the last known status instantly while the fresh one loads */
function ksCacheLoad(){
  if(KS.d)return;
  try{
    const j=JSON.parse(sessionStorage.getItem(ksCacheKey())||"null");
    if(j&&j.d&&Date.now()-j.t<6e5){KS.d=j.d;KS.err=null;ksRender()}
  }catch(e){}
}
const ksOk=r=>!!(r&&r.data&&Array.isArray(r.data.projects));
function ksFetch(fresh){
  if(ksInflight&&fresh!==true)return ksInflight;
  ksCacheLoad();
  ksInflight=(async()=>{
    const path="killswitch/status"+(fresh===true?"?fresh=1":"");
    let r=await api(path);
    // one quick retry for transient failures (network blip, 5xx)
    if(!ksOk(r)&&r&&(r.err==="NETWORK_ERROR"||/^HTTP 5/.test(r.err||"")))r=await api(path);
    if(ksOk(r)){
      KS.d={...r.data,sample:false};
      KS.err=null;
      try{sessionStorage.setItem(ksCacheKey(),JSON.stringify({t:Date.now(),d:r.data}))}catch(e){}
    }else if(!KS.d){
      // only show an error when there is nothing to show; otherwise keep the last good data
      KS.err=(r&&r.err)||"KillSwitch API returned no project data.";
    }
    ksRender();
  })().finally(()=>{ksInflight=null});
  return ksInflight;
}

async function ksAct(action,project){
  if(!KS.d)return;
  if(action==="recover"&&!confirm("Recover "+project+"? This re-arms the KillSwitch for the project."))return;
  try{
    const u=firebase.auth().currentUser;
    const r=await fetch("/api/killswitch/"+action,{method:"POST",
      headers:{"Content-Type":"application/json","Authorization":"Bearer "+await u.getIdToken()},
      body:JSON.stringify({project_id:project})});
    const j=await r.json().catch(()=>({}));
    toast(r.ok?(j.message||"Done"):(j.error||"Request failed ("+r.status+")"));
  }catch(e){toast("Network error")}
  ksFetch(true);
}

