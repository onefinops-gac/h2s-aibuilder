  font:500 .95rem var(--font-ui);letter-spacing:-.005em;
  box-shadow:0 1px 2px rgba(11,27,43,.06),0 8px 20px -14px rgba(11,27,43,.25);
  transition:border-color .15s,box-shadow .15s,transform .15s;
}
#firebaseSignIn:hover{border-color:#b9c3d2;box-shadow:0 1px 2px rgba(11,27,43,.08),0 14px 28px -14px rgba(11,27,43,.3)}
#firebaseSignIn:active{transform:translateY(1px)}
#firebaseSignIn svg{width:1.25rem;height:1.25rem;flex:none}
#firebaseAuthMessage{min-height:1.2rem;margin-top:.9rem;color:var(--bad);font-size:.82rem;line-height:1.5;overflow-wrap:anywhere}
.login-security{display:flex;gap:.75rem;align-items:flex-start;margin-top:1.1rem;padding:.95rem 1rem;border:1px solid var(--border);border-radius:11px;background:var(--surface2)}
.login-security svg{flex:none;width:1.1rem;height:1.1rem;margin-top:.1rem;stroke:var(--good);fill:none;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}
.login-security b{display:block;color:var(--text);font-size:.82rem;font-weight:500}
.login-security small{display:block;margin-top:.2rem;color:var(--muted);font-size:.78rem;line-height:1.55}
.login-panel-footer{display:flex;justify-content:space-between;align-items:center;width:100%;max-width:27rem;margin-top:3rem;padding-top:1rem;border-top:1px solid var(--border);color:var(--muted);font-size:.75rem}
.login-panel-footer .lpb{display:inline-flex;align-items:center;gap:.35rem;color:var(--text2);font-weight:500}
.login-panel-footer .lpb svg{width:.8rem;height:.8rem;fill:var(--brass);stroke:none}
.login-eyebrow{margin-bottom:.55rem;font-size:.72rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--brass)}
.login-divider{display:flex;align-items:center;gap:.8rem;margin:1.6rem 0 1rem;color:var(--muted);font-size:.72rem;letter-spacing:.08em;text-transform:uppercase}
.login-divider::before,.login-divider::after{content:"";flex:1;height:1px;background:var(--border)}
.login-trust{display:flex;align-items:center;justify-content:center;gap:.5rem;color:var(--muted);font-size:.78rem;text-align:center}
.login-trust svg{flex:none;width:.95rem;height:.95rem;stroke:var(--good);fill:none;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}

@media(max-height:860px){.login-showcase{gap:1.2rem;padding-top:28px;padding-bottom:28px}.login-hero h1{font-size:clamp(2rem,3.4vw,2.9rem);margin-bottom:.7rem}.login-hero>p{font-size:.92rem;line-height:1.55}.login-points{gap:.5rem}.login-point{padding:.6rem .9rem}}
@media(max-height:700px){.login-hero>p{display:none}.login-point{font-size:.78rem}}
@media(max-width:900px){
  .enterprise-login{grid-template-columns:1fr}
  .login-showcase{display:none}
  .login-panel{min-height:100vh;padding:2rem 1.5rem;justify-content:center}
  .login-mobile-brand{display:flex;align-items:center;gap:.65rem;margin-bottom:2.5rem;font-weight:600;font-size:.95rem;color:var(--text)}
  .login-mobile-brand .login-brand-icon{width:2.2rem;height:2.2rem}
}
@media(prefers-reduced-motion:reduce){
  .lg-line{animation:none;stroke-dashoffset:0}
  .lg-area{animation:none;opacity:1}
}
