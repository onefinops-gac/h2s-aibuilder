  NAV.forEach(n=>it.push({t:"Page",l:n[1],a:()=>{S.sel=null;setView(n[0])}}));
  agg("user").slice(0,300).forEach(u=>it.push({t:"User",l:nm(u.name),s:u.name,a:()=>openUser(u.name)}));
