<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>One FinOps</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/gridstack@10.3.1/dist/gridstack.min.css" rel="stylesheet">

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/gridstack@10.3.1/dist/gridstack-all.js"></script>

{% raw %}
<style>
/* =========================================================
   ENTERPRISE AI FINOPS — management dashboard
   Ink navy chrome, paper-grey canvas, emerald for data,
   brass reserved for the single "you are here" marker.
   ========================================================= */

:root{
  /* Type scale */
  --fs-xs:.78rem;
  --fs-sm:.875rem;
  --fs-md:.9375rem;
  --fs-lg:1.0625rem;
  --fs-h1:1.5rem;
  --fs-kpi:2rem;
  --fw-reg:400; --fw-med:500; --fw-bold:600;
  --font-ui:"Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
  --font-display:var(--font-ui);

  /* Shape: three deliberate radii */
  --r-lg:14px; --r-md:10px; --r-sm:8px;

  /* Colour */
  --ink:#0b1b2b; --ink2:#08131f;
  --bg:#f3f5f8; --surface:#ffffff; --surface2:#f8f9fb;
  --border:#e2e6ed; --border2:#edf0f5;
  --text:#0f1b2d; --text2:#46536a; --muted:#78859a;
  --accent:#0e7c66; --accent2:#12906f; --soft:#e5f2ee;
  --brass:#b8893a; --brass-soft:#f6edd9;
  --good:#0e7c4f; --goodbg:#e3f3ea;
  --bad:#b83a32; --badbg:#fbeae8;
  --warn:#96660d; --warnbg:#fbf1dc;
  --info:#2f4b7c; --infobg:#e8edf6;
  --shadow:0 1px 2px rgba(11,27,43,.04),0 6px 18px -10px rgba(11,27,43,.10);
  --lift:0 24px 60px -12px rgba(11,27,43,.28);
  --av-s:38%; --av-l:91%; --av-f:30%;
}

@media(prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#070f1a; --surface:#0f1a2a; --surface2:#0b1523;
    --border:#1f2e45; --border2:#172338;
    --text:#e9eef6; --text2:#a8b6ca; --muted:#74869f;
    --accent:#3fc4a6; --accent2:#55d3b6; --soft:#0f2f2a;
    --brass:#d6a84f; --brass-soft:#2d2411;
    --good:#43d49c; --goodbg:#0e2e25; --bad:#f2786f; --badbg:#381b1e;
    --warn:#e9b14f; --warnbg:#35280f; --info:#8aa6e6; --infobg:#16213f;
    --shadow:0 1px 2px rgba(0,0,0,.35),0 8px 24px -12px rgba(0,0,0,.5);
    --lift:0 24px 60px -12px rgba(0,0,0,.7);
    --av-s:30%; --av-l:24%; --av-f:80%;
  }
}
:root[data-theme="dark"]{
  --bg:#070f1a; --surface:#0f1a2a; --surface2:#0b1523;
  --border:#1f2e45; --border2:#172338;
  --text:#e9eef6; --text2:#a8b6ca; --muted:#74869f;
  --accent:#3fc4a6; --accent2:#55d3b6; --soft:#0f2f2a;
  --brass:#d6a84f; --brass-soft:#2d2411;
  --good:#43d49c; --goodbg:#0e2e25; --bad:#f2786f; --badbg:#381b1e;
  --warn:#e9b14f; --warnbg:#35280f; --info:#8aa6e6; --infobg:#16213f;
  --shadow:0 1px 2px rgba(0,0,0,.35),0 8px 24px -12px rgba(0,0,0,.5);
  --lift:0 24px 60px -12px rgba(0,0,0,.7);
  --av-s:30%; --av-l:24%; --av-f:80%;
}

*{box-sizing:border-box}

/* fluid root size: ~14px on 1366 laptops, 16px at 1920, 18px at 2560+ */
html{font-size:clamp(13px,.335vw + 9.4px,18px);scroll-padding-top:4.5rem}

body{
  margin:0;background:var(--bg);color:var(--text);
  font:var(--fw-reg) var(--fs-sm)/1.55 var(--font-ui);
  letter-spacing:-.006em;
  -webkit-font-smoothing:antialiased;
  font-variant-numeric:tabular-nums;
}
button,input{font-family:inherit}
svg{display:block}
button{cursor:pointer}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.hidden{display:none!important}
.muted{color:var(--muted)}
.mono{font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;font-size:var(--fs-xs)}
.r{text-align:right}

/* ---------- Sidebar ---------- */
.side{
  position:fixed;inset:0 auto 0 0;width:14rem;
  background:linear-gradient(185deg,#0e2036 0%,var(--ink) 38%,var(--ink2) 100%);
  color:#9fb0c6;padding:1.1rem .8rem .9rem;
  display:flex;flex-direction:column;z-index:30;
  border-right:1px solid rgba(255,255,255,.04);
  transition:width .18s ease;
}
.brand{display:flex;gap:.7rem;align-items:center;padding:.1rem .45rem 1.6rem;white-space:nowrap;overflow:hidden}
.logo{
  width:2.2rem;height:2.2rem;border-radius:10px;flex:none;display:grid;place-items:center;
  background:linear-gradient(145deg,#16314f,#0c2038);
  box-shadow:inset 0 0 0 1px rgba(214,168,79,.55),0 4px 14px -4px rgba(0,0,0,.5);
}
.logo svg{width:1.05rem;height:1.05rem;stroke:#e2bd74;fill:none;stroke-width:2.1;stroke-linecap:round;stroke-linejoin:round}
.brand>div:last-child{min-width:0}
.brand b{display:block;color:#f4f7fb;font-size:var(--fs-sm);font-weight:var(--fw-bold);letter-spacing:-.012em;line-height:1.2;white-space:normal}
.brand small{display:block;margin-top:2px;color:#71839c;font-size:var(--fs-xs)}
.nav{display:flex;flex-direction:column;gap:2px}
.nav button{
  position:relative;display:flex;align-items:center;gap:.7rem;width:100%;
  border:0;background:none;color:#9fb0c6;padding:.58rem .7rem;border-radius:var(--r-sm);
  font-size:var(--fs-sm);font-weight:var(--fw-reg);text-align:left;white-space:nowrap;
  transition:background .15s,color .15s;
}
.nav button svg{width:1.1rem;height:1.1rem;stroke:currentColor;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;flex:none;opacity:.85}
.nav button:hover{background:rgba(255,255,255,.055);color:#f4f7fb}
.nav button[aria-current="page"]{background:rgba(255,255,255,.075);color:#fff;font-weight:var(--fw-med)}
.nav button[aria-current="page"]::before{content:"";position:absolute;left:-.8rem;top:.5rem;bottom:.5rem;width:3px;border-radius:0 3px 3px 0;background:#d6a84f}
.nav button[aria-current="page"] svg{stroke:#e2bd74;opacity:1}
.bd{margin-left:auto;font-style:normal;font-size:var(--fs-xs);color:#b9c8dc;background:rgba(255,255,255,.07);border-radius:99px;padding:0 .5rem;min-width:1.5rem;text-align:center}
.sfoot{margin-top:auto;border:1px solid rgba(255,255,255,.07);background:rgba(255,255,255,.025);border-radius:var(--r-md);padding:.75rem .8rem;font-size:var(--fs-xs);color:#71839c;overflow:hidden}
.sfoot b{display:flex;align-items:center;gap:.5rem;color:#e6edf6;font-weight:var(--fw-med);font-size:var(--fs-xs);white-space:nowrap}
.sfoot .s{display:block;margin-top:.3rem;word-break:break-word;line-height:1.45}
.dot{width:.5rem;height:.5rem;border-radius:50%;background:#43d49c;box-shadow:0 0 0 3px rgba(67,212,156,.16);flex:none}
.dot.demo{background:#e9b14f;box-shadow:0 0 0 3px rgba(233,177,79,.18)}
.bar .dot{background:var(--good);box-shadow:0 0 0 3px var(--goodbg)}
.bar .dot.demo{background:var(--warn);box-shadow:0 0 0 3px var(--warnbg)}

/* Signed-in user, lives at the foot of the sidebar */
#firebaseAuthBar{display:flex;align-items:center;gap:.6rem;margin-top:.7rem;padding:.55rem .35rem .1rem;border-top:1px solid rgba(255,255,255,.07)}
#firebaseAuthBar.hidden{display:none!important}
.uav{width:1.85rem;height:1.85rem;border-radius:50%;flex:none;display:grid;place-items:center;background:#16314f;color:#e2bd74;font-size:var(--fs-xs);font-weight:var(--fw-bold);box-shadow:inset 0 0 0 1px rgba(214,168,79,.4)}
.umeta{flex:1;min-width:0;display:flex;flex-direction:column;align-items:flex-start;gap:1px}
#firebaseAuthEmail{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#d3deec;font-size:var(--fs-xs);font-weight:var(--fw-med)}
#firebaseSignOut{border:0;background:none;padding:0;color:#7f92ab;font-size:var(--fs-xs);font-weight:var(--fw-reg);transition:color .15s}
#firebaseSignOut:hover{color:#fff;text-decoration:underline;text-underline-offset:3px}

body.mini .side{width:4.4rem}
body.mini .brand div:last-child,body.mini .sfoot .s,body.mini #stext,body.mini .nav button span,body.mini .bd,body.mini .umeta{display:none}
body.mini .nav button{justify-content:center}
body.mini .nav button[aria-current="page"]::before{left:-.8rem}
body.mini #firebaseAuthBar{justify-content:center}
body.mini .wrap{margin-left:4.4rem}
.wrap{margin-left:14rem;transition:margin .18s ease}

/* ---------- Header ---------- */
.bar{
  position:sticky;top:0;z-index:20;display:flex;align-items:center;gap:.55rem;
  min-height:4rem;padding:.6rem 1.6rem;
  background:color-mix(in srgb,var(--bg) 82%,transparent);
  backdrop-filter:saturate(1.4) blur(14px);-webkit-backdrop-filter:saturate(1.4) blur(14px);
  border-bottom:1px solid var(--border);
}
.ttl{min-width:0}
.ttl h1{margin:0;font-size:var(--fs-h1);line-height:1.15;font-weight:650;letter-spacing:-.02em}
.ttl p{margin:.2rem 0 0;font-size:var(--fs-xs);color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sp{flex:1}
.stamp{display:flex;align-items:center;gap:.45rem;font-size:var(--fs-xs);color:var(--muted);white-space:nowrap;margin-right:.35rem}
.seg{display:flex;background:var(--border2);border:1px solid var(--border);border-radius:var(--r-sm);padding:2px}
.seg button{border:0;background:none;color:var(--text2);padding:.32rem .75rem;border-radius:6px;font-size:var(--fs-xs);font-weight:var(--fw-med);white-space:nowrap;transition:color .15s,background .15s}
.seg button:hover{color:var(--text)}
.seg button.on{background:var(--surface);color:var(--text);box-shadow:0 1px 2px rgba(11,27,43,.10),0 0 0 1px var(--border)}
.seg.sm button{padding:.2rem .55rem}
.ib{
  display:inline-flex;align-items:center;justify-content:center;gap:.4rem;
  height:2.15rem;padding:0 .8rem;border:1px solid var(--border);background:var(--surface);
  color:var(--text2);border-radius:var(--r-sm);font-size:var(--fs-xs);font-weight:var(--fw-med);white-space:nowrap;
  box-shadow:0 1px 1px rgba(11,27,43,.03);
  transition:border-color .15s,color .15s,background .15s;
}
.ib:hover{color:var(--text);border-color:color-mix(in srgb,var(--muted) 55%,var(--border))}
.ib svg{width:.95rem;height:.95rem;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.ib.primary{background:var(--ink);border-color:var(--ink);color:#fff;box-shadow:0 1px 2px rgba(11,27,43,.25)}
.ib.primary:hover{background:#13304d;border-color:#13304d;color:#fff}
.ib.on{border-color:var(--accent);color:var(--accent);background:var(--soft)}
kbd{font:var(--fw-med) .6875rem var(--font-ui);color:var(--muted);border:1px solid var(--border);border-bottom-width:2px;border-radius:5px;padding:0 5px;background:var(--surface2)}
.srch{min-width:10.5rem;justify-content:space-between;color:var(--muted)}
.srch span{display:flex;align-items:center;gap:.45rem}

/* ---------- Edit bar ---------- */
.editbar{
  position:sticky;top:4rem;z-index:19;display:flex;justify-content:space-between;align-items:center;
  gap:.6rem;flex-wrap:wrap;padding:.55rem 1.6rem;background:var(--brass-soft);
  border-bottom:1px solid color-mix(in srgb,var(--brass) 45%,transparent);font-size:var(--fs-xs);color:var(--text2);
}
.editbar b{color:var(--text);margin-right:.5rem}
.ea{display:flex;gap:.4rem}

/* ---------- Main ---------- */
main{padding:1.4rem 1.6rem 2.2rem;max-width:1760px;margin:0 auto}

/* Laptop fit: compact spacing and chart cards at 100% browser zoom. */
@media screen and (min-width: 769px) and (max-width: 1440px) {
  main { padding: .75rem .85rem 1rem; }
  .bar { min-height: 3.5rem; padding: .4rem 1rem; }
  .editbar { padding: .4rem 1rem; }
  .wh { padding: .7rem .85rem 0; min-height: 2.7rem; }
  .wb { padding: .3rem .85rem .65rem; }
  .pad { padding: .85rem; }
  .kv { font-size: 1.65rem; }
  .grid-stack { margin: -4px; }
  .dlg .lgi { padding: .25rem .35rem; }
}
@media screen and (min-width: 769px) and (max-height: 900px) {
  main { padding-top: .65rem; padding-bottom: .8rem; }
  .wh { padding-top: .6rem; min-height: 2.5rem; }
  .wb { padding-top: .25rem; padding-bottom: .5rem; }
}

.banner{display:flex;gap:.55rem;align-items:center;background:var(--warnbg);color:var(--text2);border:1px solid color-mix(in srgb,var(--warn) 30%,transparent);border-radius:var(--r-sm);padding:.6rem .9rem;font-size:var(--fs-xs);margin-bottom:.85rem}
.banner b{color:var(--warn)}
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);box-shadow:var(--shadow)}
.pad{padding:1.2rem 1.35rem}
.err{display:flex;justify-content:space-between;align-items:center;gap:.6rem;padding:.95rem 1.15rem;margin-bottom:.8rem;border-color:var(--bad)}

/* ---------- Gridstack ---------- */
.grid-stack{margin:-6px}
.grid-stack>.grid-stack-item>.grid-stack-item-content{
  background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);
  box-shadow:var(--shadow);overflow:hidden;display:flex;flex-direction:column;
}
.grid-stack>.grid-stack-placeholder>.placeholder-content{border:2px dashed var(--brass);background:var(--brass-soft);border-radius:var(--r-lg)}
.grid-stack-item.ui-draggable-dragging>.grid-stack-item-content,
.grid-stack-item.ui-resizable-resizing>.grid-stack-item-content{box-shadow:var(--lift);border-color:var(--brass)}
.grid-stack>.grid-stack-item>.ui-resizable-se{background-image:none;width:9px;height:9px;right:9px;bottom:9px;border-right:2px solid var(--brass);border-bottom:2px solid var(--brass);opacity:.9}
body.editing .grid-stack>.grid-stack-item>.grid-stack-item-content{border:1px dashed var(--brass)}

.wh{display:flex;align-items:flex-start;gap:.5rem;padding:1rem 1.2rem 0;min-height:3.2rem;flex:none}
body.editing .wh{cursor:grab;padding-left:.75rem}
body.editing .wh:active{cursor:grabbing}
.grip{display:none;width:1.1rem;height:1.4rem;place-items:center;color:var(--muted);flex:none}
.grip svg{width:.8rem;height:.8rem;fill:currentColor}
.wt{flex:1;min-width:0}
.wt h3{margin:0;font-size:var(--fs-sm);font-weight:var(--fw-med);color:var(--text2);letter-spacing:-.004em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ws{margin:.15rem 0 0;font-size:var(--fs-xs);color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.wa{display:flex;gap:.2rem;align-items:center;flex:none}
.wc{display:flex;align-items:center}
.wx{display:none;width:1.4rem;height:1.4rem;border:0;background:none;border-radius:5px;color:var(--muted);place-items:center}
.wx svg{width:.7rem;height:.7rem;stroke:currentColor;fill:none;stroke-width:2.2;stroke-linecap:round}
.wx:hover{background:var(--badbg);color:var(--bad)}
body.editing .grip,body.editing .wx{display:grid}
.wb{position:relative;flex:1;min-height:0;padding:.4rem 1.2rem 1.05rem;container-type:size}
.cv{position:absolute;inset:.25rem .65rem .5rem .65rem;min-width:0;min-height:0}
.cv canvas{display:block;max-width:100%}
.wb{min-height:11rem}
.dnc{min-height:11rem}
.scroll{height:100%;overflow:auto}
.link{border:0;background:none;color:var(--accent);font-size:var(--fs-xs);font-weight:var(--fw-med);cursor:pointer;padding:0}
.link:hover{text-decoration:underline;text-underline-offset:3px}
.sk{display:block;border-radius:var(--r-sm);background:linear-gradient(90deg,var(--border2),var(--border),var(--border2));background-size:200% 100%;animation:sh 1.3s infinite}
.sk.fill{height:100%;opacity:.6}
@keyframes sh{to{background-position:-200% 0}}
.flash{animation:fl 1.2s ease}
@keyframes fl{30%{box-shadow:0 0 0 3px var(--soft),0 0 0 5px var(--accent)}}
.gempty{text-align:center;padding:4.5rem 1.25rem;border:1px dashed var(--border);border-radius:var(--r-lg);color:var(--muted)}
.gempty b{display:block;color:var(--text2);font-size:var(--fs-md);margin-bottom:.25rem}

/* ---------- KPI ---------- */
.kw{display:flex;flex-direction:column;height:100%}
.kv{font-size:var(--fs-kpi);font-weight:var(--fw-med);letter-spacing:-.04em;line-height:1.08;color:var(--text)}
.kn{margin-top:.4rem;font-size:var(--fs-xs);color:var(--muted)}
.ksp{flex:1;min-height:0;margin-top:.45rem}
.ksp svg{width:100%;height:100%}
@container (max-height:110px){.ksp{display:none}}
.dl{display:inline-flex;font-weight:var(--fw-med);padding:.05rem .5rem;border-radius:99px;font-size:var(--fs-xs);margin-right:.4rem}
.dl.up{background:var(--badbg);color:var(--bad)}
.dl.dn{background:var(--goodbg);color:var(--good)}

/* ---------- Charts / widget content ---------- */
.split{display:flex;gap:.7rem;height:100%}
.dnc{position:relative;flex:1 1 40%;min-width:0}
.split .lgd{flex:1 1 60%;overflow:auto;align-content:center;margin:0}
@container (max-width:360px){
  .split{flex-direction:column;gap:.5rem}
  .dnc{flex:1 1 55%}
  .split .lgd{flex:1 1 45%}
}
.lgd{display:grid;gap:.5rem;align-content:center;min-width:0}
.lgd{gap:.15rem}
.lgi{display:flex;align-items:center;gap:.55rem;font-size:var(--fs-sm);min-width:0;padding:.38rem .5rem;border-radius:var(--r-sm);transition:background .15s;cursor:default}
.lgi:hover{background:var(--surface2)}
.dlg .lgi{align-items:flex-start;padding:.45rem .55rem}
.dlg .lgi i{width:.6rem;height:.6rem;border-radius:50%;margin-top:.35rem}
.dlg .lgm{flex:1;min-width:0}
.dlg .lgr{display:flex;align-items:baseline;gap:.5rem;min-width:0}
.dlg .lgr span{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.dlg .lgr em{min-width:2.3rem}
.dlg .lgbar{height:.22rem;margin-top:.3rem;border-radius:99px;background:var(--border2);overflow:hidden}
.dlg .lgbar u{display:block;height:100%;border-radius:99px;text-decoration:none}
.lgi i{width:.7rem;height:.7rem;border-radius:3px;flex:none}
.lgi span{flex:1;min-width:0;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.lgi em{font-style:normal;font-size:var(--fs-xs);color:var(--muted);white-space:nowrap;min-width:2.4rem;text-align:right}
.lgi b{font-size:var(--fs-sm);font-weight:var(--fw-med);white-space:nowrap;text-align:right}

.stack{display:flex;height:.55rem;border-radius:99px;overflow:hidden;background:var(--border2);gap:2px;margin:.15rem 0 .85rem}
.stack div{height:100%;border-radius:99px}
.tc{display:grid;gap:.4rem}
.tc>div{display:flex;align-items:center;gap:.55rem;padding:.6rem .8rem;background:var(--surface2);border:1px solid var(--border2);border-radius:var(--r-sm)}
.tc i{width:.55rem;height:.55rem;border-radius:50%;flex:none}
.tc span{flex:1;font-size:var(--fs-sm);font-weight:var(--fw-reg);color:var(--text2)}
.tc small{font-size:var(--fs-xs);color:var(--muted)}
.tc b{font-size:var(--fs-md);font-weight:var(--fw-med);letter-spacing:-.02em}
.tc>div.tot{background:var(--soft);border-color:transparent}
.tc>div.tot span{color:var(--text);font-weight:var(--fw-med)}

.lb{display:flex;align-items:center;gap:.7rem;padding:.65rem 0;border-bottom:1px solid var(--border2)}
.lb:last-child{border-bottom:0}
.lb.cl{cursor:pointer}
.lb.cl:hover .lbm b{color:var(--accent)}
.rk{width:1.1rem;font-size:var(--fs-xs);color:var(--muted);font-weight:var(--fw-med);text-align:center}
.lbm{flex:1;min-width:0}
.lbm b{display:block;font-size:var(--fs-sm);font-weight:var(--fw-med);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pb{height:.28rem;background:var(--border2);border-radius:99px;overflow:hidden;margin-top:.4rem}
.pb i{display:block;height:100%;background:var(--accent);border-radius:99px}
.lbv{text-align:right}
.lbv b{display:block;font-size:var(--fs-sm);font-weight:var(--fw-med)}
.lbv small{font-size:var(--fs-xs);color:var(--muted)}
.av{
  width:1.95rem;height:1.95rem;border-radius:50%;display:inline-grid;place-items:center;flex:none;
  font-size:var(--fs-xs);font-weight:var(--fw-bold);
  background:hsl(var(--h) var(--av-s) var(--av-l));color:hsl(var(--h) 50% var(--av-f));
}
.empty{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;text-align:center;color:var(--muted);font-size:var(--fs-xs);padding:.5rem}
.empty b{color:var(--text2);font-size:var(--fs-sm);margin-bottom:.2rem}

/* ---------- Tables ---------- */
.tw{overflow:auto;margin:0 -1.35rem -1.2rem}
table{width:100%;border-collapse:collapse}
.tw th,.mt th{
  font-size:var(--fs-xs);font-weight:var(--fw-med);color:var(--muted);text-align:left;
  padding:.65rem .85rem;background:var(--surface2);
  border-top:1px solid var(--border);border-bottom:1px solid var(--border);white-space:nowrap;position:sticky;top:0;z-index:2;
}
.tw th{cursor:pointer;user-select:none;transition:color .15s}
.tw th:hover{color:var(--text)}
th .ar{margin-left:.25rem;color:var(--accent)}
.tw td,.mt td{padding:.7rem .85rem;border-bottom:1px solid var(--border2);font-size:var(--fs-sm);max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tw th:first-child,.tw td:first-child{padding-left:1.35rem}
.tw th:last-child,.tw td:last-child{padding-right:1.35rem}
.mt th,.mt td{padding:.55rem .7rem}
.mt th:first-child,.mt td:first-child{padding-left:0}
.mt th:last-child,.mt td:last-child{padding-right:0}
.tw tbody tr:hover td{background:var(--surface2)}
tr.cl{cursor:pointer}
th.r,td.r{text-align:right}
.who{display:flex;align-items:center;gap:.6rem}
.who b{display:block;font-size:var(--fs-sm);font-weight:var(--fw-med);line-height:1.25}
.who small{display:block;font-size:var(--fs-xs);color:var(--muted)}
.share{display:flex;align-items:center;gap:.6rem;justify-content:flex-end}
.share b{font-weight:var(--fw-med)}
.share i{display:block;width:3.6rem;height:.28rem;background:var(--border2);border-radius:99px;overflow:hidden}
.share u{display:block;height:100%;background:var(--accent)}
.pill{font-size:var(--fs-xs);padding:.1rem .6rem;border-radius:99px;font-weight:var(--fw-med);background:var(--border2);color:var(--text2);border:1px solid var(--border)}
.more td{text-align:center;padding:.75rem!important;border-bottom:0}
.search{height:2.15rem;border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:var(--r-sm);padding:0 .8rem;font:var(--fw-reg) var(--fs-sm) var(--font-ui);width:14.5rem;outline:0;transition:border-color .15s,box-shadow .15s}
.search::placeholder{color:var(--muted)}
.search:focus{border-color:var(--accent);box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 16%,transparent)}

/* ---------- Secondary pages ---------- */
.page{display:grid;gap:.85rem;grid-template-columns:repeat(12,1fr);margin-bottom:.85rem}
.c7{grid-column:span 7}.c5{grid-column:span 5}.c6{grid-column:span 6}.c12{grid-column:span 12}
.hd{display:flex;justify-content:space-between;align-items:flex-start;gap:.5rem;margin-bottom:.8rem}
.hd h3{margin:0;font-size:var(--fs-md);font-weight:var(--fw-med);letter-spacing:-.008em}
.hd p{margin:.18rem 0 0;font-size:var(--fs-xs);color:var(--muted)}

.chart-view{display:flex;align-items:center;gap:.55rem;flex-shrink:0}
.chart-view>span{font-size:var(--fs-xs);font-weight:var(--fw-med);color:var(--muted)}
.chart-toggle{display:inline-flex;align-items:center;gap:2px;padding:3px;border:1px solid var(--border);border-radius:9px;background:var(--surface2,#f5f7fa)}
.chart-toggle .ib{min-height:29px;padding:.3rem .65rem;border:0;border-radius:6px;background:transparent;color:var(--muted);font-size:var(--fs-xs);font-weight:var(--fw-med);box-shadow:none}
.chart-toggle .ib[aria-pressed="true"]{background:var(--surface);color:var(--text);box-shadow:0 1px 3px rgba(0,0,0,.12)}
.chart-toggle .ib:hover{color:var(--text)}
@media(max-width:560px){.chart-view{gap:.3rem}.chart-toggle .ib{padding:.25rem .4rem}}

.box{position:relative;height:clamp(280px,36vh,400px)}
.dk{display:grid;grid-template-columns:repeat(4,1fr);gap:.85rem;margin:.85rem 0}
.dk .card{padding:1rem 1.2rem}
.dk .kl{font-size:var(--fs-xs);color:var(--text2)}
.airec-ic{width:.95rem;height:.95rem;margin-right:.45rem;vertical-align:-1px;fill:var(--brass);stroke:none}
.airec-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(15rem,1fr));gap:.7rem;margin-top:.2rem}
.airec-i{--rc:var(--accent);display:flex;gap:.7rem;padding:.8rem .9rem;border:1px solid var(--border2);border-left:3px solid var(--rc);border-radius:var(--r-md);background:var(--surface2)}
.airec-i.warn{--rc:var(--warn)}.airec-i.bad{--rc:var(--bad)}.airec-i.info{--rc:var(--info)}
.airec-i b{display:block;font-size:var(--fs-sm);font-weight:var(--fw-med);color:var(--text);margin-bottom:.15rem}
.airec-i p{margin:0;font-size:var(--fs-xs);line-height:1.5;color:var(--text2)}
.airec-i em{display:inline-block;margin-top:.4rem;font-style:normal;font-size:var(--fs-xs);font-weight:var(--fw-med);color:var(--rc)}
.dk .kv{margin-top:.4rem}
.back{margin-bottom:.85rem}
#udT{font-weight:650;font-size:1.4rem;letter-spacing:-.02em}

/* ---------- Drawer / toast / palette ---------- */
.drawer{position:fixed;top:0;right:0;bottom:0;width:min(400px,100vw);background:var(--surface);border-left:1px solid var(--border);box-shadow:var(--lift);z-index:60;display:flex;flex-direction:column;transform:translateX(100%);transition:transform .22s ease}
.drawer.open{transform:none}
.dh{display:flex;justify-content:space-between;align-items:center;padding:1.1rem 1.2rem;border-bottom:1px solid var(--border)}
.dh b{font-weight:650;font-size:1.15rem;letter-spacing:-.015em}
.dh p{margin:.2rem 0 0;font-size:var(--fs-xs);color:var(--muted)}
.dl2{flex:1;overflow:auto;padding:.35rem 1.2rem 1.25rem}
.dg{font-size:var(--fs-xs);font-weight:var(--fw-med);color:var(--muted);margin:1.1rem 0 .3rem}
.di{display:flex;align-items:center;gap:.65rem;padding:.65rem 0;border-bottom:1px solid var(--border2)}
.di>div{flex:1;min-width:0}
.di b{display:block;font-size:var(--fs-sm);font-weight:var(--fw-med)}
.di small{display:block;font-size:var(--fs-xs);color:var(--muted);line-height:1.45}
.toast{position:fixed;left:50%;bottom:1.5rem;transform:translateX(-50%);background:var(--ink);color:#fff;padding:.65rem 1.1rem;border-radius:var(--r-sm);font-size:var(--fs-sm);z-index:120;box-shadow:var(--lift);border:1px solid rgba(255,255,255,.08)}
.cmd{position:fixed;inset:0;z-index:100;background:rgba(7,15,26,.55);backdrop-filter:blur(3px);display:flex;justify-content:center;align-items:flex-start;padding-top:12vh}
.cmdb{width:min(620px,92vw);background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);box-shadow:var(--lift);overflow:hidden}
.cmdb input{width:100%;border:0;border-bottom:1px solid var(--border);background:none;color:var(--text);font:var(--fw-reg) var(--fs-lg) var(--font-ui);padding:1.05rem 1.2rem;outline:0}
#cmdl{max-height:360px;overflow:auto;padding:.45rem}
.ci{display:flex;align-items:center;gap:.65rem;padding:.6rem .8rem;border-radius:var(--r-sm);cursor:pointer;font-size:var(--fs-sm)}
.ci.on{background:var(--soft)}
.ci small{color:var(--muted);font-size:var(--fs-xs)}
.ci .t{margin-left:auto;font-size:var(--fs-xs);color:var(--muted)}
.cmdf{padding:.6rem .95rem;font-size:var(--fs-xs);color:var(--muted);border-top:1px solid var(--border);display:flex;gap:.9rem}
.foot{font-size:var(--fs-xs);color:var(--muted);margin-top:1rem;padding-top:.9rem;border-top:1px solid var(--border)}

/* ---------- KillSwitch ---------- */
.kst{display:inline-block;font-size:var(--fs-xs);font-weight:var(--fw-med);padding:.1rem .6rem;border-radius:99px;background:var(--border2);color:var(--text2)}
.kst.good{background:var(--goodbg);color:var(--good)}.kst.bad{background:var(--badbg);color:var(--bad)}
.kst.warn{background:var(--warnbg);color:var(--warn)}.kst.info{background:var(--infobg);color:var(--info)}
.ksb{position:relative;height:.5rem;min-width:8rem;background:var(--border2);border-radius:99px}
.ksb i{display:block;height:100%;border-radius:99px}
.ksb u{position:absolute;top:-3px;bottom:-3px;width:2px;background:var(--text);opacity:.45}
.ksrow{display:flex;align-items:center;gap:.8rem;padding:.6rem 0;border-bottom:1px solid var(--border2)}
.ksrow:last-child{border-bottom:0}.ksrow .lbm{flex:1;min-width:0}
.ksact{display:flex;gap:.4rem;justify-content:flex-end}
.ib:disabled{opacity:.45;cursor:not-allowed}
.ksg{display:flex;flex-wrap:wrap;align-items:center;gap:1.2rem 2.2rem;height:100%}
.ksh{display:flex;align-items:center;gap:.8rem;min-width:13rem}
.ksh i{width:.9rem;height:.9rem;border-radius:50%;flex:none;background:var(--good);box-shadow:0 0 0 5px var(--goodbg)}
.ksh.warn i{background:var(--warn);box-shadow:0 0 0 5px var(--warnbg)}.ksh.bad i{background:var(--bad);box-shadow:0 0 0 5px var(--badbg)}
.ksh b{display:block;font-size:1.15rem;font-weight:var(--fw-med);letter-spacing:-.02em}
.ksh small,.kss span,.ksn small{display:block;font-size:var(--fs-xs);color:var(--muted)}
.kss b{display:block;font-size:var(--fs-kpi);font-weight:var(--fw-med);letter-spacing:-.04em;line-height:1.1}
.kss b.bad{color:var(--bad)}.kss b.warn{color:var(--warn)}
.ksn{flex:1;min-width:14rem}.ksn .ksb{margin:.4rem 0}
.kv .bad{color:var(--bad)}.kv .warn{color:var(--warn)}.kv .ok{color:var(--good)}
/* coloured KPI boxes */
.grid-stack>.grid-stack-item>.grid-stack-item-content[data-kpi]{
  background:linear-gradient(145deg,color-mix(in srgb,var(--kc,var(--accent)) 22%,var(--surface)) 0%,color-mix(in srgb,var(--kc,var(--accent)) 6%,var(--surface)) 100%);
  border-color:color-mix(in srgb,var(--kc,var(--accent)) 40%,var(--border));
  box-shadow:inset 0 3px 0 var(--kc,var(--accent)),var(--shadow)}
[data-kpi] .wt h3{color:color-mix(in srgb,var(--kc,var(--accent)) 75%,var(--text))}
[data-type="cost"]{--kc:var(--accent)}[data-type="tokens"]{--kc:#4a6fb0}[data-type="requests"]{--kc:#7c5cbf}
[data-type="ks-near"]{--kc:var(--warn)}[data-type="ks-tripped"]{--kc:var(--bad)}
[data-type="ks-near"][data-tone="off"],[data-type="ks-tripped"][data-tone="off"]{--kc:var(--good)}
/* ---------- AI FinOps Advisor (widget + page) ---------- */
:root{--ai1:#3b82f6;--ai2:#8b5cf6;--ai3:#14b8a6;--ai-grad:linear-gradient(135deg,#3b82f6 0%,#8b5cf6 55%,#14b8a6 100%)}
.usd0{font-variant-numeric:tabular-nums}

/* blinking GenAI sparkle */
.spk{display:inline-block;width:1.1em;height:1.1em;flex:none}
.spk.blink{animation:spkblink 1.8s ease-in-out infinite;transform-origin:50% 50%}
@keyframes spkblink{0%,100%{opacity:1;transform:scale(1) rotate(0)}45%{opacity:.35;transform:scale(.8) rotate(12deg)}60%{opacity:1;transform:scale(1.18) rotate(-6deg)}}
@keyframes aiglow{0%,100%{box-shadow:0 0 0 0 rgba(99,102,241,.55),0 6px 18px -8px rgba(59,130,246,.6)}60%{box-shadow:0 0 0 9px rgba(99,102,241,0),0 6px 18px -8px rgba(59,130,246,.6)}}
@keyframes aipulse{0%,100%{opacity:1}50%{opacity:.45}}

/* sidebar nav entry */
.nav button.ai svg{stroke:#9db7ff;opacity:1;animation:spkblink 2.2s ease-in-out infinite;filter:drop-shadow(0 0 5px rgba(139,164,255,.75))}
.nav button.ai[aria-current="page"] svg{stroke:#c4d3ff}
.nav button.ai::after{content:"";position:absolute;left:1.55rem;top:.42rem;width:.45rem;height:.45rem;border-radius:50%;background:var(--ai-grad);animation:aiglow 2.2s ease-out infinite}

/* call-to-action */
.ai-cta{position:relative;display:flex;align-items:center;justify-content:center;gap:.6rem;width:100%;height:2.8rem;border:0;border-radius:var(--r-md);
  background:var(--ai-grad);color:#fff;font-size:var(--fs-sm);font-weight:600;letter-spacing:-.005em;animation:aiglow 2.2s ease-out infinite;transition:filter .15s,transform .15s}
.ai-cta:hover{filter:brightness(1.08);transform:translateY(-1px)}
.ai-cta .spk{width:1.15rem;height:1.15rem}
.ai-cta .arr{margin-left:.1rem;transition:transform .15s}
.ai-cta:hover .arr{transform:translateX(3px)}

/* headline finding cards */
.advw{display:flex;flex-direction:column;gap:.6rem;height:100%}
.fnds{flex:1;min-height:0;display:grid;grid-auto-rows:1fr;gap:.55rem}
.fnd{display:flex;align-items:center;gap:.8rem;padding:.65rem .85rem;border:1px solid var(--border2);border-radius:var(--r-md);background:var(--surface2);min-width:0}
.fnd .ico{flex:none;width:2.25rem;height:2.25rem;border-radius:10px;display:grid;place-items:center;background:var(--infobg);color:var(--info)}
.fnd .ico svg{width:1.15rem;height:1.15rem;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.fnd .tx{flex:1;min-width:0}
.fnd .lb2{display:block;font-size:var(--fs-xs);font-weight:500;color:var(--muted)}
.fnd .hv{display:block;font-size:1.1rem;font-weight:600;letter-spacing:-.02em;line-height:1.25;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.fnd .dt{display:block;margin-top:.1rem;font-size:var(--fs-xs);line-height:1.4;color:var(--text2);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.fnd.s-ok .ico{background:var(--goodbg);color:var(--good)}
.fnd.s-review .ico{background:var(--warnbg);color:var(--warn)}
.fnd.s-alert .ico{background:var(--badbg);color:var(--bad)}
.apill{flex:none;font-size:.72rem;font-weight:600;letter-spacing:.03em;text-transform:uppercase;padding:.15rem .55rem;border-radius:99px;background:var(--goodbg);color:var(--good)}
.s-review .apill{background:var(--warnbg);color:var(--warn)}
.s-alert .apill{background:var(--badbg);color:var(--bad)}
.apill.lvl-critical{background:var(--badbg);color:var(--bad)}
.apill.lvl-high{background:var(--warnbg);color:var(--warn)}
.apill.lvl-medium{background:var(--infobg);color:var(--info)}
.advmsgbox{display:flex;align-items:center;justify-content:center;height:100%;text-align:center;color:var(--muted);font-size:var(--fs-sm);padding:1rem;flex-direction:column;gap:.7rem}
.advskel{display:grid;grid-auto-rows:1fr;gap:.55rem;height:100%}
.advskel .sk{border-radius:var(--r-md)}

/* page */
.advpage{display:flex;flex-direction:column;gap:1rem}
.advkpis{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}
.advkpis .fnd{padding:1.1rem 1.25rem;gap:1rem;background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);box-shadow:var(--shadow);align-items:flex-start}
.advkpis .fnd .ico{width:2.75rem;height:2.75rem;border-radius:12px}
.advkpis .fnd .hv{font-size:1.5rem;letter-spacing:-.03em;margin:.15rem 0 .2rem}
.advkpis .fnd .dt{-webkit-line-clamp:3}
.advgrid{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(0,1fr);gap:1rem;align-items:stretch}
.advside{display:flex;flex-direction:column;gap:1rem}
.ins{padding:1.1rem 1.25rem 1.15rem}
.ins .ih{display:flex;align-items:center;justify-content:space-between;gap:.6rem;margin-bottom:.8rem}
.ins .ih h3{margin:0;font-size:var(--fs-md);font-weight:600;letter-spacing:-.01em}
.ins .ih span{font-size:var(--fs-xs);color:var(--muted)}
.ins .big{font-size:1.6rem;font-weight:650;letter-spacing:-.03em;line-height:1.1}
.ins .sub{font-size:var(--fs-xs);color:var(--text2);margin-top:.2rem}
.ins .row{display:flex;align-items:flex-start;justify-content:space-between;gap:.8rem;padding:.55rem 0;border-top:1px solid var(--border2);font-size:var(--fs-sm)}
.ins .row:first-of-type{border-top:0}
.ins .row b{display:block;font-weight:500;color:var(--text)}
.ins .row small{display:block;margin-top:.1rem;font-size:var(--fs-xs);color:var(--muted);line-height:1.4}
.ins .row .amt{flex:none;font-weight:600;color:var(--good);background:var(--goodbg);border-radius:99px;padding:.1rem .55rem;font-size:var(--fs-xs);white-space:nowrap}
.lnk{border:0;background:none;color:var(--accent);font-size:var(--fs-xs);font-weight:var(--fw-med);padding:0;cursor:pointer}
.lnk:hover{text-decoration:underline;text-underline-offset:3px}
.ins .lnk{display:inline-block;margin-top:.6rem}
.ins .none{font-size:var(--fs-sm);color:var(--muted);padding:.2rem 0}
.fcbars{display:flex;align-items:flex-end;gap:4px;height:3.4rem;margin:.8rem 0 .25rem}
.fcbars i{flex:1;display:block;background:linear-gradient(180deg,#6d8cff,#3b82f6);border-radius:4px 4px 0 0;opacity:.75;min-height:3px;transition:opacity .15s}
.fcbars i:hover{opacity:1}
.fcbars i.pk{opacity:1;background:linear-gradient(180deg,#a78bfa,#8b5cf6)}
.fcaxis{display:flex;justify-content:space-between;font-size:var(--fs-xs);color:var(--muted)}

/* premium chat */
.chat{display:flex;flex-direction:column;min-height:560px;padding:0;overflow:hidden}
.chat-h{display:flex;align-items:center;gap:.85rem;padding:1rem 1.25rem;border-bottom:1px solid var(--border);background:linear-gradient(180deg,var(--surface),var(--surface2))}
.chat-av{flex:none;width:2.5rem;height:2.5rem;border-radius:12px;display:grid;place-items:center;background:var(--ai-grad);color:#fff;box-shadow:0 6px 16px -6px rgba(99,102,241,.7)}
.chat-av .spk{width:1.25rem;height:1.25rem}
.chat-h .tt{flex:1;min-width:0}
.chat-h .tt b{display:block;font-size:var(--fs-md);font-weight:600;letter-spacing:-.01em}
.chat-h .tt small{display:block;font-size:var(--fs-xs);color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.chat-on{display:inline-flex;align-items:center;gap:.4rem;font-size:var(--fs-xs);font-weight:500;color:var(--good);background:var(--goodbg);border-radius:99px;padding:.2rem .65rem}
.chat-on i{width:.45rem;height:.45rem;border-radius:50%;background:var(--good);animation:aipulse 1.8s ease-in-out infinite}
.chat-b{flex:1 1 0;min-height:0;overflow:auto;padding:1.25rem;display:flex;flex-direction:column;gap:1rem;background:var(--surface2);scroll-behavior:smooth}
.msg{display:flex;gap:.7rem;max-width:92%}
.msg.u{align-self:flex-end;flex-direction:row-reverse}
.msg .mav{flex:none;width:1.9rem;height:1.9rem;border-radius:9px;display:grid;place-items:center;background:var(--ai-grad);color:#fff;margin-top:.1rem}
.msg .mav .spk{width:1rem;height:1rem}
.msg .bub{padding:.8rem 1rem;border-radius:16px;font-size:var(--fs-sm);line-height:1.65;word-break:break-word;min-width:0}
.msg.a .bub{background:var(--surface);border:1px solid var(--border);border-top-left-radius:5px;box-shadow:0 1px 2px rgba(11,27,43,.04);color:var(--text)}
.msg.u .bub{background:linear-gradient(135deg,#17406b,#0b1b2b);color:#fff;border-top-right-radius:5px;box-shadow:0 8px 18px -10px rgba(11,27,43,.6);white-space:pre-wrap}
.bub p{margin:0 0 .55rem}.bub p:last-child{margin-bottom:0}
.bub ul{margin:.3rem 0 .55rem;padding-left:1.15rem}.bub li{margin:.2rem 0}
.bub strong{font-weight:600}
.bub .rec{display:block;margin-top:.4rem;padding:.55rem .75rem;border-radius:10px;background:var(--soft);color:var(--text);border-left:3px solid var(--accent)}
.bub .meta{display:block;margin-top:.55rem;font-size:var(--fs-xs);color:var(--muted)}
.typing{display:inline-flex;gap:.28rem;align-items:center;padding:.25rem 0}
.typing i{width:.4rem;height:.4rem;border-radius:50%;background:var(--ai2);animation:typ 1.1s ease-in-out infinite}
.typing i:nth-child(2){animation-delay:.15s}.typing i:nth-child(3){animation-delay:.3s}
@keyframes typ{0%,60%,100%{transform:translateY(0);opacity:.4}30%{transform:translateY(-4px);opacity:1}}
.welcome{margin:auto;width:min(40rem,100%);text-align:center}
.welcome .wl{width:3.6rem;height:3.6rem;border-radius:18px;margin:0 auto 1rem;display:grid;place-items:center;background:var(--ai-grad);color:#fff;box-shadow:0 14px 30px -12px rgba(99,102,241,.7)}
