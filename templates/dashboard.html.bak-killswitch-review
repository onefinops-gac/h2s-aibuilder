    AP.busyQ=false;advChatDraw();await advSaveHistory();return;
  }
  try{
    const hist=AP.msgs.slice(-7,-1).map(m=>({role:m.role==="user"?"user":"model",text:m.text}));
    const body={question:q,period:S.p,history:hist};
    if(S.date) body.date=S.date;
