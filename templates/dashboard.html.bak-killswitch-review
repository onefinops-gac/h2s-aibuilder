    return false;
  }

  grid=GridStack.init({
    column:12,cellHeight:78,margin:4,float:false,animate:true,handle:".wh",staticGrid:true,
    columnOpts:{breakpoints:[{w:820,c:1},{w:1100,c:6}]},
    resizable:{handles:"e,se,s,sw,w"}
  },"#grid");

  /* keep widget row height proportional to the fluid font size */
  const fitRows=()=>{if(grid&&grid.cellHeight){const r=parseFloat(getComputedStyle(document.documentElement).fontSize)||16;grid.cellHeight(Math.round(r*4.875))}};
  fitRows();
  let rt;window.addEventListener("resize",()=>{clearTimeout(rt);rt=setTimeout(fitRows,120)});
